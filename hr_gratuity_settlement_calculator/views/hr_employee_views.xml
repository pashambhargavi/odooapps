<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_gratuity_inherit" model="ir.ui.view">
        <field name="name">hr.employee.form.gratuity.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_gratuity_settlements" type="object" class="oe_stat_button" icon="fa-calculator" invisible="gratuity_settlement_count == 0">
                    <div class="o_stat_info">
                        <field name="gratuity_settlement_count" class="o_stat_value"/>
                        <span class="o_stat_text">EOS Settlements</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
