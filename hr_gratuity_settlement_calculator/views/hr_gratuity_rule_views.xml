<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Gratuity Rule List View -->
    <record id="view_hr_gratuity_rule_list" model="ir.ui.view">
        <field name="name">hr.gratuity.rule.list</field>
        <field name="model">hr.gratuity.rule</field>
        <field name="arch" type="xml">
            <list string="Labor Law Gratuity Rules">
                <field name="name"/>
                <field name="code"/>
                <field name="country_id"/>
                <field name="wage_type"/>
                <field name="first_period_days_per_year" string="1st 5 Yrs (Days/Yr)"/>
                <field name="subsequent_days_per_year" string="After 5 Yrs (Days/Yr)"/>
                <field name="resignation_rule_type"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Gratuity Rule Form View -->
    <record id="view_hr_gratuity_rule_form" model="ir.ui.view">
        <field name="name">hr.gratuity.rule.form</field>
        <field name="model">hr.gratuity.rule</field>
        <field name="arch" type="xml">
            <form string="Labor Law Gratuity Rule">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Rule / Legal Framework Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. UAE Labor Law (Decree 33/2021)"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Statutory Identification">
                            <field name="code"/>
                            <field name="country_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group string="Wage Calculation Parameters">
                            <field name="wage_type"/>
                            <field name="monthly_days_divisor"/>
                            <field name="min_service_days"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Service Accrual Tiers" name="accrual">
                            <group>
                                <group string="First Service Period">
                                    <field name="first_period_years"/>
                                    <field name="first_period_days_per_year"/>
                                </group>
                                <group string="Subsequent Service Period &amp; Cap">
                                    <field name="subsequent_days_per_year"/>
                                    <field name="max_gratuity_years_cap"/>
                                </group>
                            </group>
                        </page>

                        <page string="Resignation Reductions" name="resignation">
                            <group>
                                <group string="Resignation Policy">
                                    <field name="resignation_rule_type"/>
                                </group>
                            </group>
                            <group string="Tiered Resignation Reductions" invisible="resignation_rule_type != 'ksa_tiered'">
                                <group>
                                    <field name="tier1_max_years"/>
                                    <field name="tier1_percentage"/>
                                    <field name="tier2_max_years"/>
                                    <field name="tier2_percentage"/>
                                </group>
                                <group>
                                    <field name="tier3_max_years"/>
                                    <field name="tier3_percentage"/>
                                    <field name="tier4_percentage"/>
                                </group>
                            </group>
                        </page>

                        <page string="Legal Notes &amp; Statutory References" name="notes">
                            <field name="description" placeholder="Document statutory decree numbers, official labor court guidelines, and legal interpretations..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Gratuity Rule Action -->
    <record id="action_hr_gratuity_rule" model="ir.actions.act_window">
        <field name="name">Gratuity Calculation Rules</field>
        <field name="res_model">hr.gratuity.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define your first Labor Law Gratuity Rule!
            </p>
            <p>
                Configure calculation parameters for UAE, Saudi Arabia, Qatar, Kuwait, Oman, or custom company policies.
            </p>
        </field>
    </record>
</odoo>
