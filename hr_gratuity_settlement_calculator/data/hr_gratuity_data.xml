<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Settlement Sequence -->
    <record id="seq_hr_gratuity_settlement" model="ir.sequence">
        <field name="name">End of Service Settlement Sequence</field>
        <field name="code">hr.gratuity.settlement</field>
        <field name="prefix">EOS/%(range_year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- UAE Labor Law Standard Rule -->
    <record id="rule_uae_labor_law_standard" model="hr.gratuity.rule">
        <field name="name">UAE Labor Law (Federal Decree Law No. 33 of 2021)</field>
        <field name="code">UAE_DECREE_33</field>
        <field name="wage_type">basic</field>
        <field name="monthly_days_divisor">30.0</field>
        <field name="min_service_days">365</field>
        <field name="first_period_years">5.0</field>
        <field name="first_period_days_per_year">21.0</field>
        <field name="subsequent_days_per_year">30.0</field>
        <field name="max_gratuity_years_cap">2.0</field>
        <field name="resignation_rule_type">equal</field>
        <field name="description">Standard United Arab Emirates statutory calculation under Federal Decree Law No. 33 of 2021. 21 days basic salary for each of first 5 years, 30 days for subsequent years, capped at 2 years total salary. Under the new decree, resignation entitlements match termination.</field>
    </record>

    <!-- Saudi Labor Law Standard Rule -->
    <record id="rule_ksa_labor_law_standard" model="hr.gratuity.rule">
        <field name="name">Saudi Labor Law (Articles 84 &amp; 85)</field>
        <field name="code">KSA_LABOR_LAW</field>
        <field name="wage_type">basic</field>
        <field name="monthly_days_divisor">30.0</field>
        <field name="min_service_days">365</field>
        <field name="first_period_years">5.0</field>
        <field name="first_period_days_per_year">15.0</field>
        <field name="subsequent_days_per_year">30.0</field>
        <field name="max_gratuity_years_cap">0.0</field>
        <field name="resignation_rule_type">ksa_tiered</field>
        <field name="tier1_max_years">2.0</field>
        <field name="tier1_percentage">0.0</field>
        <field name="tier2_max_years">5.0</field>
        <field name="tier2_percentage">33.33</field>
        <field name="tier3_max_years">10.0</field>
        <field name="tier3_percentage">66.67</field>
        <field name="tier4_percentage">100.0</field>
        <field name="description">Kingdom of Saudi Arabia statutory End-of-Service calculation under Labor Law Articles 84 and 85. Half-month wage (15 days) for each of first 5 years, full-month wage (30 days) for subsequent years. Resignation tiered: &lt;2 yrs = 0%, 2-5 yrs = 1/3, 5-10 yrs = 2/3, &gt;10 yrs = 100%.</field>
    </record>
</odoo>
