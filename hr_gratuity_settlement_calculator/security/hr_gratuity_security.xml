<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_hr_gratuity" model="ir.module.category">
        <field name="name">End of Service &amp; Gratuity</field>
        <field name="description">Manage UAE, Saudi &amp; GCC labor law gratuity rules, EOS settlements, exit clearances, and accounting provisions.</field>
        <field name="sequence">28</field>
    </record>

    <record id="privilege_hr_gratuity" model="res.groups.privilege">
        <field name="name">Gratuity &amp; Settlement Access</field>
        <field name="category_id" ref="module_category_hr_gratuity"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_gratuity_user" model="res.groups">
        <field name="name">Payroll &amp; Settlement Officer</field>
        <field name="privilege_id" ref="privilege_hr_gratuity"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="group_gratuity_manager" model="res.groups">
        <field name="name">HR Director / Finance Manager</field>
        <field name="privilege_id" ref="privilege_hr_gratuity"/>
        <field name="implied_ids" eval="[(4, ref('group_gratuity_user')), (4, ref('hr.group_hr_manager')), (4, ref('account.group_account_invoice'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('hr_gratuity_settlement_calculator.group_gratuity_user'))]"/>
    </record>

    <data noupdate="1">
        <!-- Multi-Company Rules -->
        <record id="rule_hr_gratuity_rule_company" model="ir.rule">
            <field name="name">Gratuity Rule: Multi-Company</field>
            <field name="model_id" ref="model_hr_gratuity_rule"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_hr_gratuity_settlement_company" model="ir.rule">
            <field name="name">Gratuity Settlement: Multi-Company</field>
            <field name="model_id" ref="model_hr_gratuity_settlement"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
