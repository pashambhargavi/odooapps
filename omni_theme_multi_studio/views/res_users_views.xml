<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_simple_modif_omni" model="ir.ui.view">
        <field name="name">res.users.preferences.form.omni</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences_page']" position="inside">
                <group string="OmniTheme 10-in-1 Workspace Theme" name="omni_theme_preferences">
                    <field name="omni_theme_selection" widget="radio"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
