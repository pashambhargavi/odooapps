<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_omni_theme_config_list" model="ir.ui.view">
        <field name="name">omni.theme.config.list</field>
        <field name="model">omni.theme.config</field>
        <field name="arch" type="xml">
            <list string="OmniTheme Studio Profiles">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="theme_key" widget="badge"/>
                <field name="primary_color" widget="color"/>
                <field name="navbar_bg" widget="color"/>
                <field name="allow_user_switching" widget="boolean_toggle"/>
                <field name="button_border_radius" widget="badge"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_omni_theme_config_form" model="ir.ui.view">
        <field name="name">omni.theme.config.form</field>
        <field name="model">omni.theme.config</field>
        <field name="arch" type="xml">
            <form string="OmniTheme Studio Profile">
                <header>
                    <button name="action_apply_theme" string="Apply &amp; Activate Theme" type="object" class="btn-primary" icon="fa-paint-brush"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Theme Profile Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Corporate Nordic Emerald Suite"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Company &amp; Permissions">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="is_active" widget="boolean_toggle"/>
                            <field name="allow_user_switching" widget="boolean_toggle"/>
                        </group>
                        <group string="Theme Preset Engine (10-in-1)">
                            <field name="theme_key" widget="radio"/>
                            <field name="button_border_radius" widget="radio"/>
                            <field name="font_family"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Live Color Palette Swatches" name="palette_swatches">
                            <group>
                                <group string="Navigation &amp; Chrome">
                                    <field name="navbar_bg" widget="color"/>
                                    <field name="navbar_text" widget="color"/>
                                    <field name="border_color" widget="color"/>
                                </group>
                                <group string="Canvas &amp; Action Accents">
                                    <field name="primary_color" widget="color"/>
                                    <field name="view_bg" widget="color"/>
                                    <field name="card_bg" widget="color"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_omni_theme_config_search" model="ir.ui.view">
        <field name="name">omni.theme.config.search</field>
        <field name="model">omni.theme.config</field>
        <field name="arch" type="xml">
            <search string="Search OmniTheme Profiles">
                <field name="name"/>
                <field name="theme_key"/>
                <field name="company_id"/>
                <filter string="Active Profile" name="filter_active" domain="[('is_active', '=', True)]"/>
                <separator/>
                <group>
                    <filter string="Theme Preset" name="group_by_preset" context="{'group_by': 'theme_key'}"/>
                    <filter string="Company" name="group_by_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_omni_theme_config" model="ir.actions.act_window">
        <field name="name">OmniTheme 10-in-1 Studio</field>
        <field name="res_model">omni.theme.config</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create and manage company-wide 10-in-1 theme configurations!
            </p>
        </field>
    </record>
</odoo>
