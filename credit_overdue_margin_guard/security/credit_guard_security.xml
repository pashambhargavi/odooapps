<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_credit_margin_guard" model="ir.module.category">
        <field name="name">Credit &amp; Margin Guard</field>
        <field name="description">Manage Customer Credit Limits, Overdue Aging Controls &amp; Profit Margin Exceptions</field>
        <field name="sequence">28</field>
    </record>

    <record id="privilege_credit_margin_guard" model="res.groups.privilege">
        <field name="name">Credit &amp; Margin Guard</field>
        <field name="category_id" ref="module_category_credit_margin_guard"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_credit_guard_user" model="res.groups">
        <field name="name">User: Request Overrides &amp; View Credit Exposure</field>
        <field name="privilege_id" ref="privilege_credit_margin_guard"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_credit_guard_manager" model="res.groups">
        <field name="name">Controller: Manage Risk Policies &amp; Approve Overrides</field>
        <field name="privilege_id" ref="privilege_credit_margin_guard"/>
        <field name="implied_ids" eval="[(4, ref('group_credit_guard_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('credit_overdue_margin_guard.group_credit_guard_user'))]"/>
    </record>

    <data noupdate="1">
        <record id="rule_credit_risk_policy_company" model="ir.rule">
            <field name="name">Credit Risk Policy: Multi-Company</field>
            <field name="model_id" ref="model_credit_risk_policy"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="rule_credit_override_request_company" model="ir.rule">
            <field name="name">Credit Override Request: Multi-Company</field>
            <field name="model_id" ref="model_credit_override_request"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
    </data>
</odoo>
