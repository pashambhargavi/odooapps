<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_shift" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.shift</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_shifts" type="object" class="oe_stat_button" icon="fa-calendar" title="Scheduled Shifts">
                    <field name="shift_count" widget="statinfo" string="Shifts"/>
                </button>
            </xpath>
            <xpath expr="//page[@name='hr_settings']//group" position="inside">
                <group string="Shift Scheduling &amp; Work Limits">
                    <field name="weekly_max_hours"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
