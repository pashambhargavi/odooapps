<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Morning Shift -->
        <record id="shift_template_morning" model="hr.shift.template">
            <field name="name">Day / Morning Shift</field>
            <field name="code">MS-08</field>
            <field name="shift_type">day</field>
            <field name="start_time">8.0</field>
            <field name="end_time">16.5</field>
            <field name="break_duration">0.5</field>
            <field name="differential_rate">0.0</field>
            <field name="required_headcount">3</field>
            <field name="color">4</field>
        </record>

        <!-- Afternoon Shift -->
        <record id="shift_template_afternoon" model="hr.shift.template">
            <field name="name">Evening / Afternoon Shift</field>
            <field name="code">AS-16</field>
            <field name="shift_type">evening</field>
            <field name="start_time">16.0</field>
            <field name="end_time">0.0</field>
            <field name="break_duration">0.5</field>
            <field name="differential_rate">10.0</field>
            <field name="required_headcount">2</field>
            <field name="color">3</field>
        </record>

        <!-- Night Shift -->
        <record id="shift_template_night" model="hr.shift.template">
            <field name="name">Overnight Duty Shift</field>
            <field name="code">NS-00</field>
            <field name="shift_type">night</field>
            <field name="start_time">0.0</field>
            <field name="end_time">8.0</field>
            <field name="break_duration">0.5</field>
            <field name="differential_rate">20.0</field>
            <field name="required_headcount">2</field>
            <field name="color">2</field>
        </record>
    </data>
</odoo>
