<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Master Roster -->
        <record id="seq_hr_shift_roster" model="ir.sequence">
            <field name="name">Duty Roster Schedule</field>
            <field name="code">hr.shift.roster</field>
            <field name="prefix">RST/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Shift Swap Request -->
        <record id="seq_hr_shift_swap" model="ir.sequence">
            <field name="name">Shift Swap Request</field>
            <field name="code">hr.shift.swap.request</field>
            <field name="prefix">SWP/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
