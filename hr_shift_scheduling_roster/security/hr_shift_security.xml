<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_hr_shift" model="ir.module.category">
        <field name="name">Shift Scheduling &amp; Duty Roster</field>
        <field name="description">Manage employee shift rosters, templates, scheduling conflicts and peer swaps.</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_shift_user" model="res.groups">
        <field name="name">Shift Employee / Worker</field>
        <field name="category_id" ref="module_category_hr_shift"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="group_shift_manager" model="res.groups">
        <field name="name">Roster Planner / Shift Manager</field>
        <field name="category_id" ref="module_category_hr_shift"/>
        <field name="implied_ids" eval="[(4, ref('group_shift_user')), (4, ref('hr.group_hr_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('hr_shift_scheduling_roster.group_shift_user'))]"/>
    </record>

    <data noupdate="1">
        <!-- Multi-Company Rules -->
        <record id="rule_hr_shift_template_company" model="ir.rule">
            <field name="name">Shift Template: Multi-Company</field>
            <field name="model_id" ref="model_hr_shift_template"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_hr_shift_roster_company" model="ir.rule">
            <field name="name">Shift Roster: Multi-Company</field>
            <field name="model_id" ref="model_hr_shift_roster"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_hr_shift_schedule_company" model="ir.rule">
            <field name="name">Shift Schedule: Multi-Company</field>
            <field name="model_id" ref="model_hr_shift_schedule"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_hr_shift_swap_company" model="ir.rule">
            <field name="name">Shift Swap: Multi-Company</field>
            <field name="model_id" ref="model_hr_shift_swap_request"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
