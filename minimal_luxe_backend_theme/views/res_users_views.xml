<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_inherit_luxe" model="ir.ui.view">
        <field name="name">res.users.form.inherit.luxe</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences_page']" position="inside">
                <group string="Minimal Luxe Personal Preferences">
                    <field name="luxe_zen_mode" widget="boolean_toggle"/>
                    <field name="luxe_personal_accent"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
