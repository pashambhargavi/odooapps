<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="minimal_luxe_login_layout" inherit_id="web.login_layout" name="Minimal Luxe Executive Login Layout">
        <xpath expr="//t[@t-call='web.frontend_layout']/div" position="replace">
            <div class="container-fluid p-0 o_luxe_login_container" style="min-height: 100vh; display: flex; align-items: stretch; background-color: #09090B; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
                <div class="row g-0 w-100 m-0">
                    <!-- Left Brand Hero Column -->
                    <div class="col-12 col-lg-7 d-none d-lg-flex flex-column justify-content-between p-5 text-white" style="background-color: #09090B; border-right: 1px solid #27272A;">
                        <div>
                            <div class="d-flex align-items-center mb-4">
                                <span style="display: inline-block; background-color: #18181B; color: #D97706; font-weight: 700; font-size: 13px; padding: 6px 18px; border-radius: 20px; letter-spacing: 1.5px; border: 1px solid #3F3F46; text-transform: uppercase;">
                                    ✦ MINIMAL LUXE ERP
                                </span>
                            </div>
                            <h1 style="font-size: 42px; font-weight: 800; line-height: 1.15; margin-bottom: 20px; color: #FAFAFA;">
                                Pure Distraction-Free Architecture &amp; Zen Operations
                            </h1>
                            <p style="font-size: 16px; color: #A1A1AA; max-width: 580px; line-height: 1.6;">
                                High-fashion monochromatic elegance. Featuring razor-thin 1px hairline precision borders, 1-click Zen focus mode, and sovereign luxury metal accents.
                            </p>
                        </div>

                        <!-- Feature Badges -->
                        <div class="row g-3 my-4">
                            <div class="col-6">
                                <div style="background-color: #121215; border: 1px solid #27272A; border-radius: 8px; padding: 18px;">
                                    <div style="color: #D97706; font-weight: 700; font-size: 14px; margin-bottom: 4px;">✦ Zen Focus Mode</div>
                                    <div style="color: #A1A1AA; font-size: 12px;">1-Click elimination of non-essential noise for 100% document flow.</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div style="background-color: #121215; border: 1px solid #27272A; border-radius: 8px; padding: 18px;">
                                    <div style="color: #FAFAFA; font-weight: 700; font-size: 14px; margin-bottom: 4px;">✦ Hairline Precision</div>
                                    <div style="color: #A1A1AA; font-size: 12px;">Linear-inspired 1px razor borders &amp; monospace financial typography.</div>
                                </div>
                            </div>
                        </div>

                        <!-- Copyright / Tech Info -->
                        <div style="color: #71717A; font-size: 13px;">
                            Minimal Luxe Backend Theme &#8226; Compatible with Odoo v14 through v20 Community &amp; Enterprise
                        </div>
                    </div>

                    <!-- Right Login Form Column -->
                    <div class="col-12 col-lg-5 d-flex flex-column justify-content-center align-items-center p-4 p-md-5" style="background-color: #09090B;">
                        <div style="width: 100%; max-width: 400px; background-color: #121215; border: 1px solid #27272A; border-radius: 12px; padding: 40px 32px; box-shadow: 0 10px 35px #000000;">
                            <div class="text-center mb-4">
                                <h3 style="color: #FAFAFA; font-size: 22px; font-weight: 700; margin: 0 0 6px 0;">Sign In</h3>
                                <p style="color: #A1A1AA; font-size: 13px; margin: 0;">Enter your credentials to access the instance</p>
                            </div>
                            <t t-raw="0"/>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
