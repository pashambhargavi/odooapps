<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_minimal_luxe_config_list" model="ir.ui.view">
        <field name="name">minimal.luxe.config.list</field>
        <field name="model">minimal.luxe.config</field>
        <field name="arch" type="xml">
            <tree string="Minimal Luxe Theme Profiles">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="theme_mode" widget="badge"/>
                <field name="luxury_accent" widget="badge"/>
                <field name="accent_hex" widget="color"/>
                <field name="zen_mode_enabled" widget="boolean_toggle"/>
                <field name="hairline_border" widget="boolean_toggle"/>
                <field name="is_active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_minimal_luxe_config_form" model="ir.ui.view">
        <field name="name">minimal.luxe.config.form</field>
        <field name="model">minimal.luxe.config</field>
        <field name="arch" type="xml">
            <form string="Minimal Luxe Theme Profile">
                <header>
                    <button name="action_apply_accent" string="Re-Apply Luxury Accent" type="object" class="btn-primary" icon="fa-diamond"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Theme Profile Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Minimal Luxe Obsidian"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Company &amp; Status">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="is_active" widget="boolean_toggle"/>
                            <field name="theme_mode" widget="radio"/>
                        </group>
                        <group string="Luxury Accent &amp; Zen Studio">
                            <field name="luxury_accent" widget="radio"/>
                            <field name="accent_hex" widget="color"/>
                            <field name="zen_mode_enabled" widget="boolean_toggle"/>
                            <field name="hairline_border" widget="boolean_toggle"/>
                            <field name="font_preset"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_minimal_luxe_config_search" model="ir.ui.view">
        <field name="name">minimal.luxe.config.search</field>
        <field name="model">minimal.luxe.config</field>
        <field name="arch" type="xml">
            <search string="Search Luxe Profiles">
                <field name="name"/>
                <field name="company_id"/>
                <filter name="active_profiles" string="Active Profiles" domain="[('is_active', '=', True)]"/>
                <separator/>
                <group>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                    <filter name="group_mode" string="Canvas Mode" context="{'group_by': 'theme_mode'}"/>
                    <filter name="group_accent" string="Luxury Accent" context="{'group_by': 'luxury_accent'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_minimal_luxe_config" model="ir.actions.act_window">
        <field name="name">Minimal Luxe Theme Profiles</field>
        <field name="res_model">minimal.luxe.config</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active_profiles': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Minimal Luxe Theme Profile!
            </p>
            <p>
                Configure Linear-style monochromatic canvases, luxury metal accents, and zen focus mode.
            </p>
        </field>
    </record>
</odoo>
