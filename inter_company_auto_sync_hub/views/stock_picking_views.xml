<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_intercompany" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.intercompany</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="intercompany_picking_id" invisible="1"/>
                <field name="auto_intercompany_created" invisible="1"/>
                <button name="action_view_intercompany_picking" type="object" class="oe_stat_button" icon="fa-truck" invisible="not intercompany_picking_id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Sister Transfer</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_intercompany" invisible="1"/>
                <span class="badge rounded-pill text-bg-info ms-2" invisible="not is_intercompany">Inter-Company Transfer</span>
            </xpath>
        </field>
    </record>
</odoo>
