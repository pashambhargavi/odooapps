<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_intercompany" model="ir.ui.view">
        <field name="name">account.move.form.inherit.intercompany</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="intercompany_move_id" invisible="1"/>
                <field name="auto_intercompany_created" invisible="1"/>
                <button name="action_view_intercompany_move" type="object" class="oe_stat_button" icon="fa-exchange" invisible="not intercompany_move_id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Sister Move</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_intercompany" invisible="1"/>
                <span class="badge rounded-pill text-bg-info ms-2" invisible="not is_intercompany">Inter-Company Entity</span>
            </xpath>
        </field>
    </record>
</odoo>
