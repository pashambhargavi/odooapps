<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_intercompany" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.intercompany</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="intercompany_sale_order_id" invisible="1"/>
                <field name="auto_intercompany_created" invisible="1"/>
                <button name="action_view_intercompany_so" type="object" class="oe_stat_button" icon="fa-retweet" invisible="not intercompany_sale_order_id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Sister SO</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_intercompany" invisible="1"/>
                <span class="badge rounded-pill text-bg-info ms-2" invisible="not is_intercompany">Inter-Company Partner</span>
            </xpath>
        </field>
    </record>
</odoo>
