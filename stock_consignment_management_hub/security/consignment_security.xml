<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_consignment" model="ir.module.category">
        <field name="name">Consignment Stock Management</field>
        <field name="description">Manage vendor consignment agreements, customer consignment locations, consumption billing, and audit reconciliations.</field>
        <field name="sequence">27</field>
    </record>

    <record id="privilege_consignment" model="res.groups.privilege">
        <field name="name">Consignment Stock Access</field>
        <field name="category_id" ref="module_category_consignment"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_consignment_user" model="res.groups">
        <field name="name">Consignment Custodian / Officer</field>
        <field name="privilege_id" ref="privilege_consignment"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_consignment_manager" model="res.groups">
        <field name="name">Consignment Manager / Controller</field>
        <field name="privilege_id" ref="privilege_consignment"/>
        <field name="implied_ids" eval="[(4, ref('group_consignment_user')), (4, ref('stock.group_stock_manager')), (4, ref('account.group_account_invoice'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('stock_consignment_management_hub.group_consignment_user'))]"/>
    </record>

    <data noupdate="1">
        <!-- Multi-Company Rules -->
        <record id="rule_consignment_agreement_company" model="ir.rule">
            <field name="name">Consignment Agreement: Multi-Company</field>
            <field name="model_id" ref="model_consignment_agreement"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_consignment_settlement_company" model="ir.rule">
            <field name="name">Consignment Settlement: Multi-Company</field>
            <field name="model_id" ref="model_consignment_settlement"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_consignment_audit_company" model="ir.rule">
            <field name="name">Consignment Audit: Multi-Company</field>
            <field name="model_id" ref="model_consignment_audit"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
