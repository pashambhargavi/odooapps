<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Consignment Agreement Sequence -->
    <record id="seq_consignment_agreement" model="ir.sequence">
        <field name="name">Consignment Agreement Sequence</field>
        <field name="code">consignment.agreement</field>
        <field name="prefix">CAG/%(range_year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Consignment Settlement Sequence -->
    <record id="seq_consignment_settlement" model="ir.sequence">
        <field name="name">Consignment Settlement Sequence</field>
        <field name="code">consignment.settlement</field>
        <field name="prefix">CST/%(range_year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Consignment Audit Sequence -->
    <record id="seq_consignment_audit" model="ir.sequence">
        <field name="name">Consignment Stock Audit Sequence</field>
        <field name="code">consignment.audit</field>
        <field name="prefix">CAU/%(range_year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
