<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Agreement Kanban View -->
    <record id="view_consignment_agreement_kanban" model="ir.ui.view">
        <field name="name">consignment.agreement.kanban</field>
        <field name="model">consignment.agreement</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="consignment_type"/>
                <field name="state"/>
                <field name="location_id"/>
                <field name="total_active_stock_qty"/>
                <field name="total_active_stock_value"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong class="fs-5 text-truncate"><field name="partner_id"/></strong>
                            <span t-attf-class="badge #{record.consignment_type.raw_value == 'vendor' ? 'text-bg-primary' : 'text-bg-success'}">
                                <t t-if="record.consignment_type.raw_value == 'vendor'">Vendor Consignment</t>
                                <t t-else="">Customer Consignment</t>
                            </span>
                        </div>
                        <div class="text-muted small mb-2">
                            <i class="fa fa-map-marker me-1" title="Location"/> <field name="location_id"/> | <field name="name"/>
                        </div>
                        <div class="row g-2 p-2 bg-light rounded my-2">
                            <div class="col-6">
                                <span class="text-muted small">On-Hand Units: </span>
                                <strong><field name="total_active_stock_qty"/></strong>
                            </div>
                            <div class="col-6 text-end">
                                <span class="text-muted small">Consigned Value: </span>
                                <strong class="text-primary"><field name="total_active_stock_value" widget="monetary"/></strong>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                            <span class="badge rounded-pill text-bg-light border"><field name="state"/></span>
                            <span class="text-muted small"><field name="billing_frequency"/></span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Agreement List View -->
    <record id="view_consignment_agreement_list" model="ir.ui.view">
        <field name="name">consignment.agreement.list</field>
        <field name="model">consignment.agreement</field>
        <field name="arch" type="xml">
            <tree string="Consignment Agreements">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="consignment_type" widget="badge"/>
                <field name="location_id"/>
                <field name="date_start"/>
                <field name="date_end" optional="show"/>
                <field name="billing_frequency"/>
                <field name="total_active_stock_qty" string="On-Hand Units"/>
                <field name="total_active_stock_value" widget="monetary" string="Consigned Value"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'active'" decoration-warning="state == 'suspended'" decoration-muted="state == 'closed'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- Agreement Form View -->
    <record id="view_consignment_agreement_form" model="ir.ui.view">
        <field name="name">consignment.agreement.form</field>
        <field name="model">consignment.agreement</field>
        <field name="arch" type="xml">
            <form string="Consignment Agreement">
                <header>
                    <button name="action_activate" string="Activate Agreement" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_create_settlement" string="Settle Consumption (Generate Bill / Invoice)" type="object" class="btn-success" invisible="state != 'active'"/>
                    <button name="action_print_statement" string="Print Stock Statement PDF" type="object" class="btn-outline-primary" icon="fa-print"/>
                    <button name="action_suspend" string="Suspend Agreement" type="object" invisible="state != 'active'"/>
                    <button name="action_close" string="Close Agreement" type="object" invisible="state not in ['active', 'suspended']"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,suspended,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_settlements" type="object" class="oe_stat_button" icon="fa-money">
                            <div class="o_stat_info">
                                <field name="settlement_count" class="o_stat_value"/>
                                <span class="o_stat_text">Settlements</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" string="Agreement Reference"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Consignment Contract Profile">
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="consignment_type" widget="radio" readonly="state != 'draft'"/>
                            <field name="location_id" domain="[('usage', '=', 'internal')]" readonly="state != 'draft'"/>
                            <field name="billing_frequency"/>
                        </group>
                        <group string="Contract Validity &amp; Governance">
                            <field name="date_start" readonly="state != 'draft'"/>
                            <field name="date_end"/>
                            <field name="currency_id"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <div class="row mt16 mb24">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded text-center border-start border-primary border-4">
                                <small class="text-muted text-uppercase fw-bold">Active On-Hand Consigned Units</small>
                                <h3 class="mb-0 text-primary mt-1"><field name="total_active_stock_qty"/></h3>
                                <small class="text-muted">Total physical inventory units currently consigned</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded text-center border-start border-success border-4">
                                <small class="text-muted text-uppercase fw-bold">Consigned Stock Valuation</small>
                                <h3 class="mb-0 text-success mt-1"><field name="total_active_stock_value" widget="monetary"/></h3>
                                <small class="text-muted">Total financial value of unsold/unconsumed consigned stock</small>
                            </div>
                        </div>
                    </div>

                    <notebook>
                        <page string="Consigned Products &amp; Agreed Prices" name="products">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="unit_price" widget="monetary"/>
                                    <field name="commission_rate" string="Commission (%)"/>
                                    <field name="max_stock_limit" string="Max Buffer Limit"/>
                                    <field name="current_stock_qty" string="On-Hand Units" readonly="1"/>
                                    <field name="total_consumed_qty" string="Total Consumed" readonly="1"/>
                                    <field name="unbilled_consumed_qty" string="Unbilled Units" readonly="1" decoration-danger="unbilled_consumed_qty &gt; 0"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Settlement History" name="settlements">
                            <field name="settlement_ids" readonly="1">
                                <tree string="Consumption Settlements">
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="total_consumed_qty"/>
                                    <field name="total_settlement_amount" widget="monetary"/>
                                    <field name="invoice_id"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Contract Terms &amp; Title Retention" name="terms">
                            <field name="terms_conditions" placeholder="Define title retention clauses, risk of loss transfer, shrinkage allowance, and payment terms..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Agreement Search View -->
    <record id="view_consignment_agreement_search" model="ir.ui.view">
        <field name="name">consignment.agreement.search</field>
        <field name="model">consignment.agreement</field>
        <field name="arch" type="xml">
            <search string="Search Consignment Agreements">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="location_id"/>
                <filter string="Active Agreements" name="active_state" domain="[('state', '=', 'active')]"/>
                <filter string="Vendor Consignment" name="vendor_type" domain="[('consignment_type', '=', 'vendor')]"/>
                <filter string="Customer Consignment" name="customer_type" domain="[('consignment_type', '=', 'customer')]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <group>
                    <filter string="Partner" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Consignment Type" name="group_by_type" context="{'group_by': 'consignment_type'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Stock Location" name="group_by_location" context="{'group_by': 'location_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Agreement Action -->
    <record id="action_consignment_agreement" model="ir.actions.act_window">
        <field name="name">Consignment Agreements</field>
        <field name="res_model">consignment.agreement</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_consignment_agreement_search"/>
        <field name="context">{'search_default_active_state': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Consignment Stock Agreement!
            </p>
            <p>
                Manage Vendor Consignment (supplier owned stock in your warehouse) and Customer Consignment (your stock at customer locations) with automated consumption billing.
            </p>
        </field>
    </record>
</odoo>
