<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_team_view_kanban" model="ir.ui.view">
        <field name="name">helpdesk.team.kanban</field>
        <field name="model">helpdesk.team</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard" create="0" sample="1">
                <field name="name"/>
                <field name="color"/>
                <field name="leader_id"/>
                <field name="description"/>
                <field name="open_ticket_count"/>
                <field name="unassigned_ticket_count"/>
                <field name="urgent_ticket_count"/>
                <field name="sla_failed_count"/>
                <templates>
                    <t t-name="card" t-attf-class="oe_kanban_color_#{kanban_getcolor(record.color.raw_value)}">
                        <div class="d-flex flex-column justify-content-between h-100 p-2">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h4 class="fw-bold mb-0">
                                        <field name="name"/>
                                    </h4>
                                    <field name="leader_id" widget="many2one_avatar_user"/>
                                </div>
                                <p class="text-muted small mb-3" t-if="record.description.raw_value">
                                    <field name="description"/>
                                </p>
                                <div class="row text-center g-2 my-2">
                                    <div class="col-3">
                                        <div class="p-2 border rounded bg-light">
                                            <div class="fw-bolder fs-5 text-primary"><field name="open_ticket_count"/></div>
                                            <div class="small text-muted">Open</div>
                                        </div>
                                    </div>
                                    <div class="col-3">
                                        <div class="p-2 border rounded bg-light">
                                            <div class="fw-bolder fs-5 text-secondary"><field name="unassigned_ticket_count"/></div>
                                            <div class="small text-muted">Unassigned</div>
                                        </div>
                                    </div>
                                    <div class="col-3">
                                        <div class="p-2 border rounded bg-light">
                                            <div class="fw-bolder fs-5 text-warning"><field name="urgent_ticket_count"/></div>
                                            <div class="small text-muted">Urgent</div>
                                        </div>
                                    </div>
                                    <div class="col-3">
                                        <div class="p-2 border rounded bg-light">
                                            <div class="fw-bolder fs-5 text-danger"><field name="sla_failed_count"/></div>
                                            <div class="small text-muted">SLA Failed</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                                <button name="action_view_team_tickets" type="object" class="btn btn-primary btn-sm">
                                    View Tickets
                                </button>
                                <button name="action_create_ticket" type="object" class="btn btn-secondary btn-sm">
                                    + New Ticket
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="helpdesk_team_view_list" model="ir.ui.view">
        <field name="name">helpdesk.team.list</field>
        <field name="model">helpdesk.team</field>
        <field name="arch" type="xml">
            <list string="Support Teams">
                <field name="sequence" widget="handle"/>
                <field name="name" decoration-bf="1"/>
                <field name="leader_id" widget="many2one_avatar_user"/>
                <field name="assignment_method"/>
                <field name="use_sla"/>
                <field name="open_ticket_count"/>
                <field name="sla_failed_count"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="helpdesk_team_view_form" model="ir.ui.view">
        <field name="name">helpdesk.team.form</field>
        <field name="model">helpdesk.team</field>
        <field name="arch" type="xml">
            <form string="Helpdesk Team">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_team_tickets" type="object"
                                class="oe_stat_button" icon="fa-life-ring">
                            <field name="open_ticket_count" widget="statinfo" string="Open Tickets"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name" string="Support Team Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Technical Escalations"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Team Assignment &amp; Leadership">
                            <field name="leader_id" widget="many2one_avatar_user"/>
                            <field name="assignment_method"/>
                            <field name="member_ids" widget="many2many_avatar_user"/>
                        </group>
                        <group string="SLA &amp; Company">
                            <field name="use_sla"/>
                            <field name="sequence"/>
                            <field name="color" widget="color_picker"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Describe the responsibilities of this support team..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="helpdesk_team_action_dashboard" model="ir.actions.act_window">
        <field name="name">Helpdesk Overview</field>
        <field name="res_model">helpdesk.team</field>
        <field name="view_mode">kanban,form</field>
    </record>

    <record id="helpdesk_team_action_config" model="ir.actions.act_window">
        <field name="name">Support Teams</field>
        <field name="res_model">helpdesk.team</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
</odoo>
