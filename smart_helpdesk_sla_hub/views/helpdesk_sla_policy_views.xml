<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_sla_policy_view_list" model="ir.ui.view">
        <field name="name">helpdesk.sla.policy.list</field>
        <field name="model">helpdesk.sla.policy</field>
        <field name="arch" type="xml">
            <list string="SLA Policies">
                <field name="sequence" widget="handle"/>
                <field name="name" decoration-bf="1"/>
                <field name="team_id"/>
                <field name="ticket_type_id" optional="show"/>
                <field name="priority" widget="badge"
                       decoration-info="priority == '0'"
                       decoration-primary="priority == '1'"
                       decoration-warning="priority == '2'"
                       decoration-danger="priority == '3'"/>
                <field name="response_time_hours"/>
                <field name="resolution_time_hours"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="helpdesk_sla_policy_view_form" model="ir.ui.view">
        <field name="name">helpdesk.sla.policy.form</field>
        <field name="model">helpdesk.sla.policy</field>
        <field name="arch" type="xml">
            <form string="Helpdesk SLA Policy">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name" string="SLA Policy Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Urgent Priority 4-Hour Resolution SLA"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Matching Criteria">
                            <field name="team_id"/>
                            <field name="ticket_type_id"/>
                            <field name="priority"/>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="SLA Time Targets">
                            <field name="response_time_hours"/>
                            <field name="resolution_time_hours"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Specify SLA policy conditions and escalation guidelines..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="helpdesk_sla_policy_action" model="ir.actions.act_window">
        <field name="name">SLA Policies</field>
        <field name="res_model">helpdesk.sla.policy</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
