<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Helpdesk Stage Views -->
    <record id="helpdesk_stage_view_list" model="ir.ui.view">
        <field name="name">helpdesk.stage.list</field>
        <field name="model">helpdesk.stage</field>
        <field name="arch" type="xml">
            <list string="Helpdesk Stages" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_in_progress"/>
                <field name="is_close"/>
                <field name="is_cancel"/>
                <field name="fold"/>
            </list>
        </field>
    </record>

    <record id="helpdesk_stage_view_form" model="ir.ui.view">
        <field name="name">helpdesk.stage.form</field>
        <field name="model">helpdesk.stage</field>
        <field name="arch" type="xml">
            <form string="Helpdesk Stage">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="fold"/>
                        </group>
                        <group>
                            <field name="is_in_progress"/>
                            <field name="is_close"/>
                            <field name="is_cancel"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Describe the criteria for tickets in this stage..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="helpdesk_stage_action" model="ir.actions.act_window">
        <field name="name">Ticket Stages</field>
        <field name="res_model">helpdesk.stage</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Ticket Type Views -->
    <record id="helpdesk_ticket_type_view_list" model="ir.ui.view">
        <field name="name">helpdesk.ticket.type.list</field>
        <field name="model">helpdesk.ticket.type</field>
        <field name="arch" type="xml">
            <list string="Ticket Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <record id="helpdesk_ticket_type_action" model="ir.actions.act_window">
        <field name="name">Ticket Types</field>
        <field name="res_model">helpdesk.ticket.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Tag Views -->
    <record id="helpdesk_tag_view_list" model="ir.ui.view">
        <field name="name">helpdesk.tag.list</field>
        <field name="model">helpdesk.tag</field>
        <field name="arch" type="xml">
            <list string="Helpdesk Tags" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="helpdesk_tag_action" model="ir.actions.act_window">
        <field name="name">Ticket Tags</field>
        <field name="res_model">helpdesk.tag</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
