<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_smart_helpdesk" model="res.groups.privilege">
        <field name="name">Smart Helpdesk</field>
        <field name="sequence">16</field>
        <field name="category_id" ref="base.module_category_services_helpdesk"/>
    </record>

    <record id="group_helpdesk_user" model="res.groups">
        <field name="name">Support Agent</field>
        <field name="comment">Can view and manage helpdesk support tickets.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_smart_helpdesk"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_helpdesk_manager" model="res.groups">
        <field name="name">Helpdesk Administrator</field>
        <field name="comment">Can configure support teams, stages, SLA policies, and reporting.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_smart_helpdesk"/>
        <field name="implied_ids" eval="[(4, ref('smart_helpdesk_sla_hub.group_helpdesk_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">
        <record id="helpdesk_team_comp_rule" model="ir.rule">
            <field name="name">Helpdesk Team: multi-company</field>
            <field name="model_id" ref="model_helpdesk_team"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="helpdesk_sla_policy_comp_rule" model="ir.rule">
            <field name="name">Helpdesk SLA Policy: multi-company</field>
            <field name="model_id" ref="model_helpdesk_sla_policy"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="helpdesk_ticket_comp_rule" model="ir.rule">
            <field name="name">Helpdesk Ticket: multi-company</field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
    </data>
</odoo>
