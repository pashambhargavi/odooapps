<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Non-Conformance Report (NCR) -->
        <record id="seq_qms_ncr" model="ir.sequence">
            <field name="name">Quality Non-Conformance Report</field>
            <field name="code">qms.ncr</field>
            <field name="prefix">NCR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Corrective Action (CAPA) -->
        <record id="seq_qms_capa" model="ir.sequence">
            <field name="name">Corrective &amp; Preventive Action</field>
            <field name="code">qms.capa</field>
            <field name="prefix">CAPA/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Quality Audit -->
        <record id="seq_qms_audit" model="ir.sequence">
            <field name="name">ISO Quality Audit</field>
            <field name="code">qms.audit</field>
            <field name="prefix">AUD/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Quality Risk -->
        <record id="seq_qms_risk" model="ir.sequence">
            <field name="name">Quality Risk / FMEA</field>
            <field name="code">qms.risk</field>
            <field name="prefix">RSK/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
