<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_qms" model="ir.module.category">
        <field name="name">Quality Management System (QMS)</field>
        <field name="description">Manage ISO 9001:2015, IATF 16949, AS9100 QMS, NCR, 8D CAPA, Audits and Risk Registers.</field>
        <field name="sequence">29</field>
    </record>

    <record id="group_qms_user" model="res.groups">
        <field name="name">Quality Inspector / User</field>
        <field name="category_id" ref="module_category_qms"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_qms_manager" model="res.groups">
        <field name="name">Quality Manager / Lead Auditor</field>
        <field name="category_id" ref="module_category_qms"/>
        <field name="implied_ids" eval="[(4, ref('group_qms_user')), (4, ref('stock.group_stock_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('iso_quality_management_qms.group_qms_user'))]"/>
    </record>

    <data noupdate="1">
        <!-- Multi-Company Rules -->
        <record id="rule_qms_ncr_company" model="ir.rule">
            <field name="name">NCR: Multi-Company</field>
            <field name="model_id" ref="model_qms_ncr"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_qms_capa_company" model="ir.rule">
            <field name="name">CAPA: Multi-Company</field>
            <field name="model_id" ref="model_qms_capa"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_qms_audit_company" model="ir.rule">
            <field name="name">Audit: Multi-Company</field>
            <field name="model_id" ref="model_qms_audit"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_qms_risk_company" model="ir.rule">
            <field name="name">Risk: Multi-Company</field>
            <field name="model_id" ref="model_qms_risk"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
