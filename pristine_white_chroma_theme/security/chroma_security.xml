<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_chroma_theme" model="ir.module.category">
        <field name="name">Pristine White Chroma Theme</field>
        <field name="description">Manage pristine white canvases, vibrant headers, and chromatic button styling.</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_chroma_theme_user" model="res.groups">
        <field name="name">Chroma Theme User (Personal Header Color)</field>
        <field name="category_id" ref="module_category_chroma_theme"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_chroma_theme_manager" model="res.groups">
        <field name="name">Chroma Theme Administrator (Brand &amp; Canvas Manager)</field>
        <field name="category_id" ref="module_category_chroma_theme"/>
        <field name="implied_ids" eval="[(4, ref('group_chroma_theme_user')), (4, ref('base.group_system'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('pristine_white_chroma_theme.group_chroma_theme_user'))]"/>
    </record>

    <data noupdate="1">
        <!-- Multi-Company Rule -->
        <record id="rule_chroma_theme_config_company" model="ir.rule">
            <field name="name">Chroma Theme Config: Multi-Company</field>
            <field name="model_id" ref="model_chroma_theme_config"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
