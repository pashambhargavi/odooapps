<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_theme_apex_config_list" model="ir.ui.view">
        <field name="name">theme.apex.config.list</field>
        <field name="model">theme.apex.config</field>
        <field name="arch" type="xml">
            <tree string="Apex Cyber Theme Profiles">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="neon_preset" widget="badge"/>
                <field name="neon_color" widget="color"/>
                <field name="glass_blur_strength"/>
                <field name="neon_glow_strength"/>
                <field name="font_family"/>
                <field name="is_active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_theme_apex_config_form" model="ir.ui.view">
        <field name="name">theme.apex.config.form</field>
        <field name="model">theme.apex.config</field>
        <field name="arch" type="xml">
            <form string="Apex Cyber Theme Profile">
                <header>
                    <button name="action_apply_preset" string="Re-Apply Neon Preset" type="object" class="btn-secondary" icon="fa-bolt"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Cyber Theme Profile Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Electric Cyan Cyber Theme"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Company &amp; Activation">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="is_active" widget="boolean_toggle"/>
                            <field name="neon_preset" widget="radio"/>
                        </group>
                        <group string="Cyber Neon Color Palette">
                            <field name="neon_color" widget="color"/>
                            <field name="neon_glow_color"/>
                            <field name="glass_card_bg"/>
                            <field name="glass_surface_border"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Glassmorphism &amp; Glow Effects" name="glass_effects">
                            <group>
                                <group string="Acrylic Glass Blur">
                                    <field name="glass_blur_strength"/>
                                    <field name="neon_glow_strength"/>
                                    <field name="font_family"/>
                                </group>
                                <group string="Visual Interactivity">
                                    <field name="enable_glass_app_drawer"/>
                                    <field name="enable_glowing_inputs"/>
                                    <field name="enable_sticky_glass_headers"/>
                                    <field name="enable_glass_dock_mobile"/>
                                </group>
                            </group>
                        </page>

                        <page string="Futuristic Login Portal" name="login_portal">
                            <group>
                                <field name="login_headline"/>
                                <field name="login_subtext"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_theme_apex_config_search" model="ir.ui.view">
        <field name="name">theme.apex.config.search</field>
        <field name="model">theme.apex.config</field>
        <field name="arch" type="xml">
            <search string="Search Apex Theme Configurations">
                <field name="name"/>
                <field name="company_id"/>
                <filter string="Active Profiles" name="active_profiles" domain="[('is_active', '=', True)]"/>
                <separator/>
                <group>
                    <filter string="Neon Preset" name="group_preset" context="{'group_by': 'neon_preset'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_theme_apex_config" model="ir.actions.act_window">
        <field name="name">Apex Cyber Themes</field>
        <field name="res_model">theme.apex.config</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_theme_apex_config_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create and customize your Apex Glassmorphism &amp; Cyber Neon theme!
            </p>
        </field>
    </record>
</odoo>
