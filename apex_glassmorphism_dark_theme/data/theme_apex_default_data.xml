        <field name="company_id" ref="base.main_company"/>
        <field name="is_active">True</field>
        <field name="neon_preset">electric_cyan</field>
        <field name="neon_color">#00F0FF</field>
        <field name="neon_glow_color">rgba(0, 240, 255, 0.4)</field>
