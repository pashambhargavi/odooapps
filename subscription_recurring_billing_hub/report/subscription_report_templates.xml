<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_subscription_agreement_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1e293b;">
                        <!-- Header Title Box -->
                        <div class="row mb-4 pb-3 border-bottom">
                            <div class="col-7">
                                <h2 style="font-size:26px;font-weight:800;color:#0f172a;margin-bottom:4px;">
                                    SUBSCRIPTION SERVICE AGREEMENT
                                </h2>
                                <span class="badge text-bg-primary" style="font-size:13px;padding:6px 12px;">
                                    Ref: <t t-esc="doc.name"/>
                                </span>
                            </div>
                            <div class="col-5 text-end">
                                <div style="font-size:13px;color:#64748b;">
                                    <strong>Billing Plan:</strong> <t t-esc="doc.plan_id.name"/><br/>
                                    <strong>Agreement Date:</strong> <t t-esc="doc.date_start"/><br/>
                                    <strong>Current Status:</strong> <t t-esc="dict(doc._fields['state'].selection).get(doc.state)"/>
                                </div>
                            </div>
                        </div>

                        <!-- Client and Contract Parameters -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <div style="background-color:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;padding:14px;">
                                    <strong style="color:#0f172a;font-size:14px;text-transform:uppercase;">Subscribed Client:</strong>
                                    <h4 style="margin:6px 0 4px 0;color:#1e293b;font-weight:700;"><t t-esc="doc.partner_id.name"/></h4>
                                    <div style="font-size:13px;color:#475569;">
                                        <t t-if="doc.partner_id.street"><t t-esc="doc.partner_id.street"/><br/></t>
                                        <t t-if="doc.partner_id.city"><t t-esc="doc.partner_id.city"/>, </t>
                                        <t t-if="doc.partner_id.country_id"><t t-esc="doc.partner_id.country_id.name"/><br/></t>
                                        <t t-if="doc.partner_id.email">Email: <t t-esc="doc.partner_id.email"/><br/></t>
                                        <t t-if="doc.partner_id.phone">Phone: <t t-esc="doc.partner_id.phone"/></t>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div style="background-color:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;padding:14px;">
                                    <strong style="color:#0f172a;font-size:14px;text-transform:uppercase;">Contract Terms:</strong>
                                    <table class="table table-sm table-borderless mb-0 mt-1" style="font-size:13px;">
                                        <tr>
                                            <td style="color:#64748b;">Start Date:</td>
                                            <td><strong><t t-esc="doc.date_start"/></strong></td>
                                        </tr>
                                        <tr>
                                            <td style="color:#64748b;">Expiration Date:</td>
                                            <td><strong><t t-esc="doc.date_end or 'Auto-Renewing Indefinitely'"/></strong></td>
                                        </tr>
                                        <tr>
                                            <td style="color:#64748b;">Next Invoice:</td>
                                            <td><strong><t t-esc="doc.next_invoice_date or 'N/A'"/></strong></td>
                                        </tr>
                                        <tr>
                                            <td style="color:#64748b;">Account Executive:</td>
                                            <td><t t-esc="doc.user_id.name"/></td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Itemized Table -->
                        <h4 style="font-size:16px;font-weight:700;color:#0f172a;margin-bottom:10px;">Subscribed Products &amp; Services</h4>
                        <table class="table table-bordered table-sm mb-4" style="font-size:13px;border-color:#e2e8f0;">
                            <thead style="background-color:#f1f5f9;">
                                <tr>
                                    <th style="padding:8px 10px;">Description</th>
                                    <th class="text-center" style="padding:8px 10px;">Qty</th>
                                    <th class="text-end" style="padding:8px 10px;">Unit Price</th>
                                    <th class="text-center" style="padding:8px 10px;">Disc %</th>
                                    <th class="text-end" style="padding:8px 10px;">Cycle Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.line_ids" t-as="line">
                                    <td style="padding:8px 10px;">
                                        <strong><t t-esc="line.product_id.name"/></strong>
                                        <div style="color:#64748b;font-size:12px;"><t t-esc="line.name"/></div>
                                    </td>
                                    <td class="text-center" style="padding:8px 10px;"><t t-esc="line.quantity"/></td>
                                    <td class="text-end" style="padding:8px 10px;"><span t-field="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                    <td class="text-center" style="padding:8px 10px;"><t t-esc="line.discount or 0.0"/>%</td>
                                    <td class="text-end" style="padding:8px 10px;font-weight:600;"><span t-field="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Totals & Revenue Metrics -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <div style="background-color:#eff6ff;border:1px solid #bfdbfe;border-radius:6px;padding:12px;">
                                    <strong style="color:#1e40af;font-size:13px;">Recurring Revenue Metrics</strong>
                                    <div class="d-flex justify-content-between mt-2" style="font-size:13px;">
                                        <span>Monthly Recurring (MRR):</span>
                                        <strong style="color:#2563eb;"><span t-field="doc.mrr" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></strong>
                                    </div>
                                    <div class="d-flex justify-content-between mt-1" style="font-size:13px;">
                                        <span>Annualized Recurring (ARR):</span>
                                        <strong style="color:#16a34a;"><span t-field="doc.arr" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></strong>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <table class="table table-sm table-borderless text-end" style="font-size:13px;">
                                    <tr>
                                        <td><strong>Untaxed Amount:</strong></td>
                                        <td><span t-field="doc.amount_untaxed" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Taxes:</strong></td>
                                        <td><span t-field="doc.amount_tax" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                    </tr>
                                    <tr class="border-top">
                                        <td style="font-size:15px;"><strong>Recurring Total per Cycle:</strong></td>
                                        <td style="font-size:15px;font-weight:bold;color:#0f172a;"><span t-field="doc.amount_total" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Signatures & Acceptance -->
                        <div class="row pt-4 mt-4 border-top">
                            <div class="col-6">
                                <p style="font-size:12px;color:#64748b;margin-bottom:45px;">
                                    Authorized Provider Signature &amp; Stamp
                                </p>
                                <div style="border-top:1px solid #94a3b8;width:80%;">
                                    <small style="color:#64748b;"><t t-esc="doc.company_id.name"/></small>
                                </div>
                            </div>
                            <div class="col-6">
                                <p style="font-size:12px;color:#64748b;margin-bottom:45px;">
                                    Customer Acceptance &amp; Signature
                                </p>
                                <div style="border-top:1px solid #94a3b8;width:80%;">
                                    <small style="color:#64748b;"><t t-esc="doc.partner_id.name"/></small>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
