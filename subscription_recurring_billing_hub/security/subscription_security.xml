<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_subscription" model="ir.module.category">
        <field name="name">Subscriptions &amp; Recurring Billing</field>
        <field name="description">Manage subscription contracts, recurring billing plans, and renewals.</field>
        <field name="sequence">22</field>
    </record>

    <record id="privilege_subscription" model="res.groups.privilege">
        <field name="name">Subscriptions</field>
        <field name="category_id" ref="module_category_subscription"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_subscription_user" model="res.groups">
        <field name="name">User: View &amp; Manage Contracts</field>
        <field name="privilege_id" ref="privilege_subscription"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_subscription_manager" model="res.groups">
        <field name="name">Administrator: Manage Plans &amp; Settings</field>
        <field name="privilege_id" ref="privilege_subscription"/>
        <field name="implied_ids" eval="[(4, ref('group_subscription_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('subscription_recurring_billing_hub.group_subscription_user'))]"/>
    </record>

    <data noupdate="1">
        <record id="rule_subscription_plan_company" model="ir.rule">
            <field name="name">Subscription Plan: Multi-Company</field>
            <field name="model_id" ref="model_subscription_plan"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="rule_subscription_contract_company" model="ir.rule">
            <field name="name">Subscription Contract: Multi-Company</field>
            <field name="model_id" ref="model_subscription_contract"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="rule_subscription_contract_line_company" model="ir.rule">
            <field name="name">Subscription Line: Multi-Company</field>
            <field name="model_id" ref="model_subscription_contract_line"/>
            <field name="domain_force">[('contract_id.company_id', 'in', company_ids + [False])]</field>
        </record>
    </data>
</odoo>
