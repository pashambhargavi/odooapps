<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Daily Recurring Invoicing Cron -->
        <record id="cron_subscription_invoicing" model="ir.cron">
            <field name="name">Subscriptions: Automated Daily Recurring Invoicing</field>
            <field name="model_id" ref="model_subscription_contract"/>
            <field name="state">code</field>
            <field name="code">model.cron_subscription_recurring_invoicing()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <!-- Daily Subscription Expiration Alert Cron -->
        <record id="cron_subscription_expiration_alert" model="ir.cron">
            <field name="name">Subscriptions: Check Expiring Contracts &amp; Notify</field>
            <field name="model_id" ref="model_subscription_contract"/>
            <field name="state">code</field>
            <field name="code">model.cron_subscription_expiration_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
