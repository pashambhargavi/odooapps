<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="sub_plan_monthly_standard" model="subscription.plan">
            <field name="name">Monthly Recurring Retainer / SaaS</field>
            <field name="code">SUB-MONTHLY</field>
            <field name="sequence">10</field>
            <field name="billing_interval">month</field>
            <field name="billing_interval_count">1</field>
            <field name="auto_invoice">True</field>
            <field name="auto_post_invoice">False</field>
            <field name="reminder_days_before">7</field>
            <field name="description">Standard monthly subscription plan. Invoices are generated automatically on the scheduled day of each month.</field>
        </record>

        <record id="sub_plan_quarterly_maintenance" model="subscription.plan">
            <field name="name">Quarterly Maintenance Agreement (QMA)</field>
            <field name="code">SUB-QUARTERLY</field>
            <field name="sequence">20</field>
            <field name="billing_interval">month</field>
            <field name="billing_interval_count">3</field>
            <field name="auto_invoice">True</field>
            <field name="auto_post_invoice">False</field>
            <field name="reminder_days_before">14</field>
            <field name="description">Quarterly billing plan every 3 months for preventive maintenance and regular service visits.</field>
        </record>

        <record id="sub_plan_annual_amc" model="subscription.plan">
            <field name="name">Annual Support &amp; License Agreement (AMC)</field>
            <field name="code">SUB-ANNUAL</field>
            <field name="sequence">30</field>
            <field name="billing_interval">year</field>
            <field name="billing_interval_count">1</field>
            <field name="auto_invoice">True</field>
            <field name="auto_post_invoice">False</field>
            <field name="reminder_days_before">30</field>
            <field name="description">Annual subscription contract. Generates yearly invoice and schedules high-priority renewal activities 30 days prior to contract termination.</field>
        </record>
    </data>
</odoo>
