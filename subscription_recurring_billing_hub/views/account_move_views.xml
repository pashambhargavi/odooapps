<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_subscription" model="ir.ui.view">
        <field name="name">account.move.form.subscription</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_origin_subscription" type="object" class="oe_stat_button" icon="fa-repeat" invisible="not subscription_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Subscription</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="subscription_id" readonly="1" invisible="not subscription_id"/>
            </xpath>
        </field>
    </record>
</odoo>
