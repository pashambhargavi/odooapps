<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_commission" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.commission</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_agent_commissions" type="object"
                        class="oe_stat_button" icon="fa-line-chart"
                        invisible="not is_commission_agent and commission_line_count == 0">
                    <field name="commission_line_count" widget="statinfo" string="Commissions"/>
                </button>
            </xpath>
            <xpath expr="//page[@name='sales_purchases']//group[@name='sale']" position="inside">
                <field name="is_commission_agent"/>
                <field name="commission_plan_id" invisible="not is_commission_agent"/>
                <field name="total_commission_earned" widget="monetary" invisible="not is_commission_agent"/>
            </xpath>
        </field>
    </record>

    <record id="view_users_form_inherit_commission" model="ir.ui.view">
        <field name="name">res.users.form.inherit.commission</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_user_worksheets" type="object"
                        class="oe_stat_button" icon="fa-calculator">
                    <field name="commission_worksheet_count" widget="statinfo" string="Worksheets"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Sales Commission" name="commission_settings">
                    <group>
                        <group string="Assigned Incentive Structure">
                            <field name="commission_plan_id"/>
                            <field name="total_commission_earned" widget="monetary" class="fw-bold fs-5 text-success"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
