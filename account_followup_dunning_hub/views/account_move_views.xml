<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add Overdue Badges to Outbound Customer Invoice List -->
    <record id="view_out_invoice_tree_followup_inherit" model="ir.ui.view">
        <field name="name">account.move.tree.followup.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date_due']" position="after">
                <field name="days_overdue" widget="badge" decoration-danger="days_overdue &gt; 30" decoration-warning="days_overdue &gt; 0 and days_overdue &lt;= 30" optional="show"/>
                <field name="is_overdue" column_invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- Add Overdue Filters to Invoice Search View -->
    <record id="view_account_invoice_filter_followup_inherit" model="ir.ui.view">
        <field name="name">account.move.select.followup.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='late']" position="after">
                <filter name="filter_overdue_30_plus" string="Severely Overdue (&gt; 30 Days)" domain="[('days_overdue', '&gt;', 30)]"/>
            </xpath>
        </field>
    </record>
</odoo>
