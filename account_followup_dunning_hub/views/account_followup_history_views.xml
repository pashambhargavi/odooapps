<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_followup_history_list" model="ir.ui.view">
        <field name="name">account.followup.history.list</field>
        <field name="model">account.followup.history</field>
        <field name="arch" type="xml">
            <list string="Follow-up Action Audit" create="false" edit="false">
                <field name="action_date"/>
                <field name="partner_id"/>
                <field name="followup_level_id"/>
                <field name="action_type" widget="badge" decoration-info="action_type == 'cron'" decoration-success="action_type == 'promise'" decoration-warning="action_type == 'phone'"/>
                <field name="total_overdue_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="invoices_count"/>
                <field name="promised_payment_date"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_account_followup_history_form" model="ir.ui.view">
        <field name="name">account.followup.history.form</field>
        <field name="model">account.followup.history</field>
        <field name="arch" type="xml">
            <form string="Follow-up Log Entry" create="false" edit="false">
                <sheet>
                    <group>
                        <group string="Customer &amp; Action Details">
                            <field name="partner_id"/>
                            <field name="action_date"/>
                            <field name="action_type"/>
                            <field name="followup_level_id"/>
                            <field name="user_id"/>
                        </group>
                        <group string="Financial Context">
                            <field name="total_overdue_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="invoices_count"/>
                            <field name="promised_payment_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Discussion Notes &amp; Audit Trail" name="notes">
                            <field name="notes" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_followup_history" model="ir.actions.act_window">
        <field name="name">Follow-up History Log</field>
        <field name="res_model">account.followup.history</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
