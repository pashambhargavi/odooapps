<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_followup" model="ir.module.category">
        <field name="name">Customer Follow-up &amp; Dunning</field>
        <field name="description">Manage payment reminder levels, dunning escalations, and overdue balances.</field>
        <field name="sequence">25</field>
    </record>

    <record id="privilege_followup" model="res.groups.privilege">
        <field name="name">Payment Follow-Up Access</field>
        <field name="category_id" ref="module_category_followup"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_followup_user" model="res.groups">
        <field name="name">User (Credit Controller)</field>
        <field name="privilege_id" ref="privilege_followup"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('account.group_account_invoice'))]"/>
    </record>

    <record id="group_followup_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_followup"/>
        <field name="implied_ids" eval="[(4, ref('group_followup_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('account_followup_dunning_hub.group_followup_user'))]"/>
    </record>

    <data noupdate="1">
        <!-- Multi-Company Rule: Follow-up Level -->
        <record id="rule_followup_level_multi_company" model="ir.rule">
            <field name="name">Follow-up Level: Multi-Company</field>
            <field name="model_id" ref="model_account_followup_level"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Multi-Company Rule: Follow-up History -->
        <record id="rule_followup_history_multi_company" model="ir.rule">
            <field name="name">Follow-up History: Multi-Company</field>
            <field name="model_id" ref="model_account_followup_history"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
