<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_petty_cash" model="ir.module.category">
        <field name="name">Petty Cash &amp; Imprest Funds</field>
        <field name="description">Manage multi-custodian petty cash boxes, expense vouchers, cash counts, and bank replenishments.</field>
        <field name="sequence">22</field>
    </record>

    <record id="group_petty_cash_user" model="res.groups">
        <field name="name">Custodian (Cashier)</field>
        <field name="category_id" ref="module_category_petty_cash"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_petty_cash_manager" model="res.groups">
        <field name="name">Finance Manager / Comptroller</field>
        <field name="category_id" ref="module_category_petty_cash"/>
        <field name="implied_ids" eval="[(4, ref('group_petty_cash_user')), (4, ref('account.group_account_invoice'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('petty_cash_expense_fund_manager.group_petty_cash_user'))]"/>
    </record>

    <data noupdate="1">
        <!-- Multi-Company Rules -->
        <record id="rule_petty_cash_fund_company" model="ir.rule">
            <field name="name">Petty Cash Fund: Multi-Company</field>
            <field name="model_id" ref="model_petty_cash_fund"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_petty_cash_voucher_company" model="ir.rule">
            <field name="name">Petty Cash Voucher: Multi-Company</field>
            <field name="model_id" ref="model_petty_cash_voucher"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_petty_cash_replenishment_company" model="ir.rule">
            <field name="name">Petty Cash Replenishment: Multi-Company</field>
            <field name="model_id" ref="model_petty_cash_replenishment"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_petty_cash_tally_company" model="ir.rule">
            <field name="name">Petty Cash Tally: Multi-Company</field>
            <field name="model_id" ref="model_petty_cash_tally"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>