<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Replenishment List View -->
    <record id="view_petty_cash_replenishment_list" model="ir.ui.view">
        <field name="name">petty.cash.replenishment.list</field>
        <field name="model">petty.cash.replenishment</field>
        <field name="arch" type="xml">
            <list string="Imprest Replenishments" decoration-success="state == 'reimbursed'" decoration-info="state == 'approved'">
                <field name="name"/>
                <field name="date"/>
                <field name="fund_id"/>
                <field name="bank_journal_id"/>
                <field name="total_reimbursement" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="custodian_id"/>
                <field name="state" widget="badge" decoration-warning="state == 'submitted'" decoration-primary="state == 'approved'" decoration-success="state == 'reimbursed'"/>
            </list>
        </field>
    </record>

    <!-- Replenishment Form View -->
    <record id="view_petty_cash_replenishment_form" model="ir.ui.view">
        <field name="name">petty.cash.replenishment.form</field>
        <field name="model">petty.cash.replenishment</field>
        <field name="arch" type="xml">
            <form string="Imprest Fund Replenishment">
                <header>
                    <button name="action_submit" string="Submit to Finance" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve Replenishment" type="object" class="btn-primary" invisible="state != 'submitted'" groups="petty_cash_expense_fund_manager.group_petty_cash_manager"/>
                    <button name="action_reimburse" string="Execute Bank Transfer &amp; Restore Float" type="object" class="btn-success" invisible="state != 'approved'" groups="petty_cash_expense_fund_manager.group_petty_cash_manager"/>
                    <button name="action_cancel" string="Cancel Request" type="object" invisible="state in ('reimbursed', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,reimbursed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label">Replenishment Request</span>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Fund &amp; Source Bank">
                            <field name="fund_id" readonly="state != 'draft'"/>
                            <field name="bank_journal_id" readonly="state in ('reimbursed', 'cancelled')"/>
                            <field name="date" readonly="state in ('reimbursed', 'cancelled')"/>
                        </group>
                        <group string="Custodian &amp; Accounting">
                            <field name="custodian_id"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="move_id" invisible="not move_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Vouchers to Reimburse" name="vouchers">
                            <field name="voucher_ids" readonly="state in ('reimbursed', 'cancelled')" widget="many2many">
                                <list string="Vouchers">
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="payee"/>
                                    <field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_reimbursement" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </group>
                        </page>
                        <page string="Justification Notes" name="notes">
                            <field name="notes" placeholder="Enter treasury or comptroller notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_petty_cash_replenishment_search" model="ir.ui.view">
        <field name="name">petty.cash.replenishment.search</field>
        <field name="model">petty.cash.replenishment</field>
        <field name="arch" type="xml">
            <search string="Search Replenishments">
                <field name="name"/>
                <field name="fund_id"/>
                <field name="bank_journal_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="submitted" string="Pending Finance Approval" domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="Approved (Ready to Fund)" domain="[('state', '=', 'approved')]"/>
                <filter name="reimbursed" string="Reimbursed" domain="[('state', '=', 'reimbursed')]"/>
                <group>
                    <filter name="group_fund" string="Petty Cash Fund" context="{'group_by': 'fund_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_petty_cash_replenishment" model="ir.actions.act_window">
        <field name="name">Replenishment Requests</field>
        <field name="res_model">petty.cash.replenishment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_petty_cash_replenishment_search"/>
    </record>
</odoo>
