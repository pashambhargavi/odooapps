<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence: Petty Cash Voucher -->
        <record id="seq_petty_cash_voucher" model="ir.sequence">
            <field name="name">Petty Cash Expense Voucher</field>
            <field name="code">petty.cash.voucher</field>
            <field name="prefix">PCV/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence: Petty Cash Replenishment -->
        <record id="seq_petty_cash_replenishment" model="ir.sequence">
            <field name="name">Petty Cash Replenishment</field>
            <field name="code">petty.cash.replenishment</field>
            <field name="prefix">PCR/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence: Petty Cash Cash Count Tally -->
        <record id="seq_petty_cash_tally" model="ir.sequence">
            <field name="name">Petty Cash Count Tally</field>
            <field name="code">petty.cash.tally</field>
            <field name="prefix">PCT/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
