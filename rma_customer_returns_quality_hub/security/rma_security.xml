<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_rma" model="ir.module.category">
        <field name="name">RMA &amp; Customer Returns</field>
        <field name="description">Manage customer return authorizations, quality inspection, and refunds.</field>
        <field name="sequence">28</field>
    </record>

    <record id="privilege_rma" model="res.groups.privilege">
        <field name="name">RMA Access</field>
        <field name="category_id" ref="module_category_rma"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_rma_user" model="res.groups">
        <field name="name">User: Process Returns &amp; Inspections</field>
        <field name="privilege_id" ref="privilege_rma"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_rma_manager" model="res.groups">
        <field name="name">Administrator: Manage Returns, Approvals &amp; Settings</field>
        <field name="privilege_id" ref="privilege_rma"/>
        <field name="implied_ids" eval="[(4, ref('group_rma_user')), (4, ref('account.group_account_invoice'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('rma_customer_returns_quality_hub.group_rma_user'))]"/>
    </record>

    <data noupdate="1">
        <record id="rule_rma_order_company" model="ir.rule">
            <field name="name">RMA Order: Multi-Company</field>
            <field name="model_id" ref="model_rma_order"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
