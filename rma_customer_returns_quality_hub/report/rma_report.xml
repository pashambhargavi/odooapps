<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_rma_order" model="ir.actions.report">
        <field name="name">RMA Customer Return Slip</field>
        <field name="model">rma.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rma_customer_returns_quality_hub.report_rma_order</field>
        <field name="report_file">rma_customer_returns_quality_hub.report_rma_order</field>
        <field name="print_report_name">'RMA Return Slip - %s' % object.name</field>
        <field name="binding_model_id" ref="model_rma_order"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_rma_order">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
                        <div class="row mb-4">
                            <div class="col-8">
                                <h2 style="font-weight: 800; color: #1e3a8a;">
                                    Return Authorization Slip: <span t-field="o.name"/>
                                </h2>
                                <p style="color: #64748b; font-size: 14px;">
                                    Please place this slip inside your return package before dispatching.
                                </p>
                            </div>
                            <div class="col-4 text-end">
                                <span class="badge" style="background-color: #2563eb; color: #ffffff; font-size: 14px; padding: 6px 14px;">
                                    <span t-field="o.state"/>
                                </span>
                            </div>
                        </div>

                        <div class="row mb-4" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 15px;">
                            <div class="col-6">
                                <strong>Customer Information:</strong><br/>
                                <span t-field="o.partner_id.name"/><br/>
                                <span t-field="o.partner_id.street"/><br/>
                                <span t-field="o.partner_id.city"/> <span t-field="o.partner_id.zip"/><br/>
                                Phone: <span t-field="o.partner_id.phone"/><br/>
                                Email: <span t-field="o.partner_id.email"/>
                            </div>
                            <div class="col-6">
                                <strong>Return Details:</strong><br/>
                                <strong>RMA Date:</strong> <span t-field="o.date_rma" t-options="{'widget': 'date'}"/><br/>
                                <strong>Receiving Warehouse:</strong> <span t-field="o.warehouse_id.name"/><br/>
                                <strong>Target Resolution:</strong> <span t-field="o.resolution_type"/><br/>
                                <t t-if="o.sale_id">
                                    <strong>Origin Order:</strong> <span t-field="o.sale_id.name"/><br/>
                                </t>
                            </div>
                        </div>

                        <table class="table table-sm table-bordered mt-3" style="width: 100%;">
                            <thead style="background-color: #1e3a8a; color: #ffffff;">
                                <tr>
                                    <th>Product</th>
                                    <th>Reason for Return</th>
                                    <th>Desired Action</th>
                                    <th class="text-end">Authorized Qty</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="line">
                                    <td><span t-field="line.product_id.display_name"/></td>
                                    <td><span t-field="line.reason_id.name"/></td>
                                    <td><span t-field="line.action_type"/></td>
                                    <td class="text-end"><span t-field="line.return_qty"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="row mt-4" style="border-top: 2px dashed #cbd5e1; padding-top: 15px;">
                            <div class="col-12">
                                <h5>Warehouse Receiving Instructions:</h5>
                                <ol style="font-size: 13px; color: #475569;">
                                    <li>Attach barcode/label on the outside carton.</li>
                                    <li>Goods will undergo quality inspection upon receipt at the receiving dock.</li>
                                    <li>Refunds or replacement shipments will be approved immediately upon successful inspection.</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
