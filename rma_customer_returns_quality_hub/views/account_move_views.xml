<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_rma" model="ir.ui.view">
        <field name="name">account.move.form.inherit.rma</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_rma" string="Create RMA Return" type="object" class="btn-secondary"
                        invisible="state != 'posted' or move_type != 'out_invoice'"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_rmas" type="object" class="oe_stat_button" icon="fa-refresh"
                        invisible="rma_count == 0">
                    <field name="rma_count" widget="statinfo" string="RMA Returns"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
