<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="nexus_pro_login_layout" inherit_id="web.login_layout" name="Nexus Pro Executive Login Layout">
        <xpath expr="//t[@t-call='web.frontend_layout']/div" position="replace">
            <div class="container-fluid p-0 o_nexus_login_container" style="min-height: 100vh; display: flex; align-items: stretch; background-color: #0F172A; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
                <div class="row g-0 w-100 m-0">
                    <!-- Left Brand Hero Column -->
                    <div class="col-12 col-lg-7 d-none d-lg-flex flex-column justify-content-between p-5 text-white" style="background-color: #0F172A; border-right: 1px solid #1E293B;">
                        <div>
                            <div class="d-flex align-items-center mb-4">
                                <span style="display: inline-block; background-color: #1E40AF; color: #FFFFFF; font-weight: 800; font-size: 13px; padding: 5px 16px; border-radius: 20px; letter-spacing: 1px; text-transform: uppercase;">
                                    ★ NEXUS PRO ENTERPRISE WORKSPACE
                                </span>
                            </div>
                            <h1 style="font-size: 40px; font-weight: 800; line-height: 1.2; margin-bottom: 20px; color: #FFFFFF;">
                                Adaptive ERP Architecture &amp; Productivity Studio
                            </h1>
                            <p style="font-size: 16px; color: #94A3B8; max-width: 580px; line-height: 1.6;">
                                Engineered for high-output enterprises. Featuring 3-in-1 adaptive navigation layouts, instant side-by-side chatter toggling, and compact high-density accounting registers.
                            </p>
                        </div>

                        <!-- Feature Badges -->
                        <div class="row g-3 my-4">
                            <div class="col-6">
                                <div style="background-color: #1E293B; border: 1px solid #334155; border-radius: 10px; padding: 18px;">
                                    <div style="color: #38BDF8; font-weight: 700; font-size: 14px; margin-bottom: 4px;">⚡ 3-in-1 Adaptive Layouts</div>
                                    <div style="color: #94A3B8; font-size: 12px;">SaaS Collapsible Sidebar, Enterprise Topbar &amp; Slim Mini-Rail.</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div style="background-color: #1E293B; border: 1px solid #334155; border-radius: 10px; padding: 18px;">
                                    <div style="color: #34D399; font-weight: 700; font-size: 14px; margin-bottom: 4px;">💬 Smart Split Chatter</div>
                                    <div style="color: #94A3B8; font-size: 12px;">1-Click live toggle between side-by-side and bottom stacked messaging.</div>
                                </div>
                            </div>
                        </div>

                        <!-- Copyright / Tech Info -->
                        <div style="color: #64748B; font-size: 13px;">
                            Nexus Pro Backend Theme &#8226; Compatible with Odoo v14 through v20 Community &amp; Enterprise
                        </div>
                    </div>

                    <!-- Right Login Form Column -->
                    <div class="col-12 col-lg-5 d-flex flex-column justify-content-center align-items-center p-4 p-md-5" style="background-color: #162032;">
                        <div style="width: 100%; max-width: 420px; background-color: #0F172A; border: 1px solid #334155; border-radius: 14px; padding: 40px 32px; box-shadow: 0 10px 30px #000000;">
                            <div class="text-center mb-4">
                                <h3 style="color: #FFFFFF; font-size: 24px; font-weight: 800; margin: 0 0 6px 0;">Sign In</h3>
                                <p style="color: #94A3B8; font-size: 13px; margin: 0;">Access your unified corporate ERP instance</p>
                            </div>
                            <t t-raw="0"/>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
