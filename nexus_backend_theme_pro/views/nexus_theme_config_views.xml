<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_nexus_theme_config_list" model="ir.ui.view">
        <field name="name">nexus.theme.config.list</field>
        <field name="model">nexus.theme.config</field>
        <field name="arch" type="xml">
            <list string="Nexus Pro Theme Profiles">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="layout_mode" widget="badge"/>
                <field name="chatter_position" widget="badge"/>
                <field name="table_density" widget="badge"/>
                <field name="color_preset" widget="badge"/>
                <field name="primary_color" widget="color"/>
                <field name="accent_color" widget="color"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_nexus_theme_config_form" model="ir.ui.view">
        <field name="name">nexus.theme.config.form</field>
        <field name="model">nexus.theme.config</field>
        <field name="arch" type="xml">
            <form string="Nexus Pro Theme Profile">
                <header>
                    <button name="action_apply_preset" string="Re-Apply Color Preset" type="object" class="btn-primary" icon="fa-refresh"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Theme Profile Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Nexus Pro Corporate Suite"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Company &amp; Status">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="is_active" widget="boolean_toggle"/>
                            <field name="layout_mode" widget="radio"/>
                        </group>
                        <group string="UX &amp; Productivity Settings">
                            <field name="chatter_position" widget="radio"/>
                            <field name="table_density" widget="radio"/>
                            <field name="sticky_header"/>
                            <field name="sticky_chatter"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="🎨 Corporate Color Palette" name="colors">
                            <group>
                                <group string="Preset Selector">
                                    <field name="color_preset" widget="radio"/>
                                </group>
                                <group string="Color Codes">
                                    <field name="primary_color" widget="color"/>
                                    <field name="accent_color" widget="color"/>
                                    <field name="sidebar_bg" widget="color"/>
                                    <field name="header_bg" widget="color"/>
                                </group>
                            </group>
                        </page>

                        <page string="📐 Typography &amp; Borders" name="styling">
                            <group>
                                <group string="Font Engine">
                                    <field name="font_family"/>
                                </group>
                                <group string="Corner Radius">
                                    <field name="border_radius"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_nexus_theme_config_search" model="ir.ui.view">
        <field name="name">nexus.theme.config.search</field>
        <field name="model">nexus.theme.config</field>
        <field name="arch" type="xml">
            <search string="Search Theme Profiles">
                <field name="name"/>
                <field name="company_id"/>
                <filter name="active_profiles" string="Active Profiles" domain="[('is_active', '=', True)]"/>
                <separator/>
                <group>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                    <filter name="group_layout" string="Layout Mode" context="{'group_by': 'layout_mode'}"/>
                    <filter name="group_preset" string="Color Preset" context="{'group_by': 'color_preset'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_nexus_theme_config" model="ir.actions.act_window">
        <field name="name">Nexus Pro Theme Profiles</field>
        <field name="res_model">nexus.theme.config</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active_profiles': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Nexus Pro Theme Profile!
            </p>
            <p>
                Configure 3-in-1 layout styles, side-by-side chatter placement, compact/spacious table density, and corporate branding colors.
            </p>
        </field>
    </record>
</odoo>
