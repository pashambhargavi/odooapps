<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_inherit_nexus" model="ir.ui.view">
        <field name="name">res.users.form.inherit.nexus</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences_page']" position="inside">
                <group string="Nexus Pro Personal Workspace Preferences">
                    <field name="nexus_chatter_position"/>
                    <field name="nexus_layout_mode"/>
                    <field name="nexus_table_density"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
