<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_stock_landed_cost" model="ir.module.category">
        <field name="name">Landed Cost &amp; Import Duty Hub</field>
        <field name="description">Manage landed cost allocations, customs duties, and stock valuation adjustments.</field>
        <field name="sequence">40</field>
    </record>

    <record id="group_landed_cost_user" model="res.groups">
        <field name="name">Landed Cost User</field>
        <field name="category_id" ref="module_category_stock_landed_cost"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_landed_cost_manager" model="res.groups">
        <field name="name">Landed Cost Administrator</field>
        <field name="category_id" ref="module_category_stock_landed_cost"/>
        <field name="implied_ids" eval="[(4, ref('group_landed_cost_user')), (4, ref('stock.group_stock_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">
        <record id="rule_stock_landed_cost_hub_company" model="ir.rule">
            <field name="name">Stock Landed Cost Hub: Multi-Company</field>
            <field name="model_id" ref="model_stock_landed_cost_hub"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
