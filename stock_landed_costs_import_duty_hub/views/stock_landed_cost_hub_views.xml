<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_stock_landed_cost_hub_list" model="ir.ui.view">
        <field name="name">stock.landed.cost.hub.list</field>
        <field name="model">stock.landed.cost.hub</field>
        <field name="arch" type="xml">
            <list string="Landed Cost &amp; Import Duty Records">
                <field name="name"/>
                <field name="date"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="picking_ids" widget="many2many_tags"/>
                <field name="account_journal_id"/>
                <field name="total_cost" widget="monetary"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'computed'"
                       decoration-success="state == 'posted'"
                       decoration-muted="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_stock_landed_cost_hub_form" model="ir.ui.view">
        <field name="name">stock.landed.cost.hub.form</field>
        <field name="model">stock.landed.cost.hub</field>
        <field name="arch" type="xml">
            <form string="Landed Cost &amp; Import Duty Document">
                <header>
                    <button name="action_compute_landed_cost"
                            string="Compute Landed Cost"
                            type="object"
                            class="btn-primary"
                            invisible="state not in ['draft', 'computed']"/>
                    <button name="action_post_landed_cost"
                            string="Post to Stock &amp; Valuation"
                            type="object"
                            class="btn-success"
                            invisible="state != 'computed'"/>
                    <button name="action_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state != 'cancel'"/>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="state in ['posted', 'cancel']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,computed,posted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Landed Cost Reference"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Logistics &amp; Receipts">
                            <field name="date" readonly="state == 'posted'"/>
                            <field name="picking_ids" widget="many2many_tags" readonly="state == 'posted'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state == 'posted'"/>
                        </group>
                        <group string="Financial Accounts">
                            <field name="account_journal_id" readonly="state == 'posted'"/>
                            <field name="account_move_id" readonly="1" invisible="not account_move_id"/>
                            <field name="total_cost" widget="monetary" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Cost Lines (Charges &amp; Tariffs)" name="cost_lines">
                            <field name="cost_line_ids" readonly="state == 'posted'">
                                <list editable="bottom" string="Landed Cost Charges">
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="split_method"/>
                                    <field name="foreign_amount"/>
                                    <field name="foreign_currency_id"/>
                                    <field name="exchange_rate"/>
                                    <field name="price_unit" widget="monetary"/>
                                    <field name="vendor_bill_id"/>
                                    <field name="account_id"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>

                        <page string="Valuation Adjustments" name="valuation_adjustments">
                            <field name="valuation_adjustment_lines" readonly="1">
                                <list string="Adjustments per Product">
                                    <field name="product_id"/>
                                    <field name="stock_move_id"/>
                                    <field name="quantity"/>
                                    <field name="former_cost" widget="monetary"/>
                                    <field name="additional_landed_cost" widget="monetary"/>
                                    <field name="final_unit_cost" widget="monetary"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>

                        <page string="Internal Notes" name="internal_notes">
                            <field name="description" placeholder="Add maritime container reference, bill of lading number, or customs broker notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_stock_landed_cost_hub_search" model="ir.ui.view">
        <field name="name">stock.landed.cost.hub.search</field>
        <field name="model">stock.landed.cost.hub</field>
        <field name="arch" type="xml">
            <search string="Search Landed Costs">
                <field name="name"/>
                <field name="picking_ids"/>
                <field name="account_journal_id"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Computed" name="filter_computed" domain="[('state', '=', 'computed')]"/>
                <filter string="Posted" name="filter_posted" domain="[('state', '=', 'posted')]"/>
                <separator/>
                <group>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'date'}"/>
                    <filter string="Company" name="group_by_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_stock_landed_cost_hub" model="ir.actions.act_window">
        <field name="name">Landed Costs &amp; Import Duties</field>
        <field name="res_model">stock.landed.cost.hub</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Landed Cost record to allocate customs, freight, and port duties across incoming shipments!
            </p>
        </field>
    </record>
</odoo>
