<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_subscription_pro" model="ir.module.category">
        <field name="name">Subscriptions &amp; Recurring Billing Pro</field>
        <field name="description">Manage recurring subscription contracts, auto-invoicing, prorata upgrades, and MRR metrics.</field>
        <field name="sequence">40</field>
    </record>

    <record id="group_subscription_user" model="res.groups">
        <field name="name">Subscription User</field>
        <field name="category_id" ref="module_category_subscription_pro"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_subscription_manager" model="res.groups">
        <field name="name">Subscription Administrator</field>
        <field name="category_id" ref="module_category_subscription_pro"/>
        <field name="implied_ids" eval="[(4, ref('group_subscription_user')), (4, ref('sales_team.group_sale_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">
        <record id="rule_subscription_pro_multi_company" model="ir.rule">
            <field name="name">Subscription Multi-Company Rule</field>
            <field name="model_id" ref="model_subscription_pro"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_subscription_plan_multi_company" model="ir.rule">
            <field name="name">Subscription Plan Multi-Company Rule</field>
            <field name="model_id" ref="model_subscription_plan_pro"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
