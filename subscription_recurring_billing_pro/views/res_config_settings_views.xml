<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_subscription" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.subscription</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="80"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Subscriptions Pro" string="Subscriptions Pro" name="subscription_recurring_billing_pro">
                    <block title="Subscription &amp; Recurring Invoicing Engine" id="subscription_settings">
                        <setting string="Auto-Post Recurring Invoices" help="Automatically validate customer invoices generated by recurring contracts.">
                            <field name="subscription_auto_post_invoices"/>
                        </setting>
                        <setting string="Default Dunning Grace Days" help="Grace period before marking an overdue subscription as paused.">
                            <field name="subscription_default_grace_days"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
