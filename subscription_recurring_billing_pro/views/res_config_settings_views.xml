<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_subscription" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.subscription</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="80"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Subscriptions Pro" string="Subscriptions Pro" data-key="subscription_recurring_billing_pro">
                    <h2>Subscription &amp; Recurring Invoicing Engine</h2>
                    <div class="row mt16 o_settings_container" id="subscription_settings">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="subscription_auto_post_invoices"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Auto-Post Recurring Invoices</span>
                                <div class="text-muted">
                                    Automatically validate customer invoices generated by recurring contracts.
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="subscription_default_grace_days"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Default Dunning Grace Days</span>
                                <div class="text-muted">
                                    Grace period before marking an overdue subscription as paused.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>