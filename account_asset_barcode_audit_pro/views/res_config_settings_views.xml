<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_asset" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.asset</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="85"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Fixed Assets Pro" string="Fixed Assets Pro" data-key="account_asset_barcode_audit_pro">
                    <h2>Fixed Asset &amp; Barcode Audit Configuration</h2>
                    <div class="row mt16 o_settings_container" id="asset_settings">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="asset_auto_post_depreciation"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Automatic Schedule Posting</span>
                                <div class="text-muted">
                                    Automatically post due depreciation journal entries on the scheduled date via daily automated cron.
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="asset_strict_audit_mode"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Strict Physical Audit Verification</span>
                                <div class="text-muted">
                                    Require physical barcode scan confirmation prior to permitting asset location or custodian reallocations.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>