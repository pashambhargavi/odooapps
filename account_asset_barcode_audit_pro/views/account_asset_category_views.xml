<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_asset_pro_category_list" model="ir.ui.view">
        <field name="name">account.asset.pro.category.list</field>
        <field name="model">account.asset.pro.category</field>
        <field name="arch" type="xml">
            <tree string="Asset Categories">
                <field name="name"/>
                <field name="method"/>
                <field name="method_number"/>
                <field name="method_period"/>
                <field name="journal_id"/>
                <field name="account_asset_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_account_asset_pro_category_form" model="ir.ui.view">
        <field name="name">account.asset.pro.category.form</field>
        <field name="model">account.asset.pro.category</field>
        <field name="arch" type="xml">
            <form string="Asset Category">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Category Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Machinery &amp; Equipment, IT Laptops, Office Furniture"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Depreciation Rules">
                            <field name="method"/>
                            <label for="method_number" string="Duration"/>
                            <div class="o_row">
                                <field name="method_number"/>
                                <field name="method_period"/>
                            </div>
                            <field name="method_progress_factor" invisible="method != 'degressive'"/>
                            <field name="prorata"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Accounting Configuration">
                            <field name="journal_id"/>
                            <field name="account_asset_id"/>
                            <field name="account_depreciation_id"/>
                            <field name="account_expense_id"/>
                            <field name="account_gain_id"/>
                            <field name="account_loss_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_asset_pro_category" model="ir.actions.act_window">
        <field name="name">Asset Categories</field>
        <field name="res_model">account.asset.pro.category</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Fixed Asset Category!
            </p>
            <p>
                Define depreciation computation rules, default duration periods, and general ledger accounts for asset classifications.
            </p>
        </field>
    </record>
</odoo>
