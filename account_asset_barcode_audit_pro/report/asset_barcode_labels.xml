<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_asset_barcode_labels">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; padding: 20px;">
                    <div style="border: 2px solid #0F172A; border-radius: 10px; padding: 18px; max-width: 480px; margin: 0 auto; background-color: #FFFFFF;">
                        <!-- Header with Company and Asset Title -->
                        <div style="border-bottom: 2px solid #6366F1; padding-bottom: 8px; margin-bottom: 12px; display: flex; justify-content: space-between; align-items: center;">
                            <div>
                                <h3 style="margin: 0; font-size: 18px; font-weight: bold; color: #0F172A;">
                                    <span t-field="doc.name"/>
                                </h3>
                                <div style="font-size: 11px; color: #64748B; margin-top: 3px;">
                                    <span t-field="doc.company_id.name"/> &#8226; Fixed Asset Property
                                </div>
                            </div>
                            <div style="text-align: right;">
                                <span style="background-color: #0F172A; color: #FFFFFF; padding: 4px 10px; border-radius: 4px; font-size: 12px; font-weight: bold;">
                                    <span t-field="doc.code"/>
                                </span>
                            </div>
                        </div>

                        <!-- Barcode Rendering -->
                        <div style="text-align: center; margin: 16px 0;">
                            <img t-att-src="'/report/barcode/?barcode_type=Code128&amp;value=%s&amp;width=400&amp;height=100' % (doc.barcode or doc.code)" style="max-width: 100%; height: 70px;"/>
                            <div style="font-size: 14px; font-weight: bold; letter-spacing: 2px; color: #0F172A; margin-top: 4px;">
                                <span t-field="doc.barcode"/>
                            </div>
                        </div>

                        <!-- Asset Metadata Grid -->
                        <table style="width: 100%; font-size: 11px; border-collapse: collapse; margin-top: 10px;">
                            <tr>
                                <td style="padding: 4px 0; color: #64748B; width: 35%;">Category:</td>
                                <td style="padding: 4px 0; font-weight: bold; color: #0F172A;"><span t-field="doc.category_id.name"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 4px 0; color: #64748B;">Serial Number:</td>
                                <td style="padding: 4px 0; font-weight: bold; color: #0F172A;"><span t-field="doc.serial_no"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 4px 0; color: #64748B;">Location:</td>
                                <td style="padding: 4px 0; font-weight: bold; color: #0F172A;"><span t-field="doc.location_name"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 4px 0; color: #64748B;">Custodian:</td>
                                <td style="padding: 4px 0; font-weight: bold; color: #0F172A;"><span t-field="doc.custodian_name"/></td>
                            </tr>
                        </table>

                        <!-- Security Notice Footer -->
                        <div style="border-top: 1px dashed #CBD5E1; margin-top: 12px; padding-top: 8px; font-size: 9px; color: #94A3B8; text-align: center;">
                            Do not remove or deface this label. Direct audit inquiries to Corporate Asset Administration.
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
