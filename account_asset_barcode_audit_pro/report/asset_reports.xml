<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_asset_barcode_labels" model="ir.actions.report">
        <field name="name">Asset Barcode &amp; QR Labels</field>
        <field name="model">account.asset.pro</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">account_asset_barcode_audit_pro.report_asset_barcode_labels</field>
        <field name="report_file">account_asset_barcode_audit_pro.report_asset_barcode_labels</field>
