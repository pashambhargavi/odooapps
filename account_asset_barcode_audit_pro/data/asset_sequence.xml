<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_account_asset_pro" model="ir.sequence">
            <field name="name">Fixed Asset Code Sequence</field>
            <field name="code">account.asset.pro</field>
            <field name="prefix">AST/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_asset_audit_session" model="ir.sequence">
            <field name="name">Asset Audit Session Sequence</field>
            <field name="code">asset.audit.session</field>
            <field name="prefix">AUD/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
