<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_asset_pro" model="ir.module.category">
        <field name="name">Fixed Assets &amp; Barcode Audit Pro</field>
        <field name="description">Manage fixed asset registers, automated depreciation schedules, physical barcode audits, and asset retirements.</field>
        <field name="sequence">45</field>
    </record>

    <record id="group_asset_user" model="res.groups">
        <field name="name">Asset User</field>
        <field name="category_id" ref="module_category_asset_pro"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_asset_manager" model="res.groups">
        <field name="name">Asset Administrator</field>
        <field name="category_id" ref="module_category_asset_pro"/>
        <field name="implied_ids" eval="[(4, ref('group_asset_user')), (4, ref('account.group_account_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">
        <record id="rule_asset_pro_multi_company" model="ir.rule">
            <field name="name">Asset Multi-Company Rule</field>
            <field name="model_id" ref="model_account_asset_pro"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_asset_category_multi_company" model="ir.rule">
            <field name="name">Asset Category Multi-Company Rule</field>
            <field name="model_id" ref="model_account_asset_pro_category"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_asset_audit_session_multi_company" model="ir.rule">
            <field name="name">Asset Audit Session Multi-Company Rule</field>
            <field name="model_id" ref="model_asset_audit_session"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
