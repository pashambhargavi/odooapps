<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fixed_asset_list" model="ir.ui.view">
        <field name="name">fixed.asset.list</field>
        <field name="model">fixed.asset</field>
        <field name="arch" type="xml">
            <list string="Fixed Assets" decoration-muted="state == 'disposed'" decoration-info="state == 'draft'"
                  decoration-success="state == 'close'">
                <field name="name"/>
                <field name="reference" optional="show"/>
                <field name="category_id"/>
                <field name="acquisition_date"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="original_value" sum="Total Gross"/>
                <field name="depreciated_value" sum="Total Depreciated"/>
                <field name="book_value" sum="Total Net Book Value"/>
                <field name="next_depreciation_date" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'"
                       decoration-success="state == 'running'" decoration-warning="state == 'close'"
                       decoration-muted="state == 'disposed'"/>
            </list>
        </field>
    </record>

    <record id="view_fixed_asset_kanban" model="ir.ui.view">
        <field name="name">fixed.asset.kanban</field>
        <field name="model">fixed.asset</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold fs-5"/>
                        <field name="category_id" class="text-muted"/>
                        <div class="d-flex justify-content-between mt-2">
                            <span>Gross: <field name="original_value" widget="monetary"/></span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Net Book Value: <field name="book_value" widget="monetary"/></span>
                        </div>
                        <footer>
                            <field name="acquisition_date"/>
                            <field name="state" widget="label_selection"
                                   options="{'classes': {'draft': 'info', 'running': 'success', 'close': 'warning', 'disposed': 'default'}}"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_fixed_asset_form" model="ir.ui.view">
        <field name="name">fixed.asset.form</field>
        <field name="model">fixed.asset</field>
        <field name="arch" type="xml">
            <form string="Fixed Asset">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_compute_board" type="object" string="Compute Depreciation"
                            invisible="state not in ('draft', 'running') or posted_line_count &gt; 0"/>
                    <button name="action_post_due_lines" type="object" string="Post Due Entries"
                            invisible="state != 'running'"/>
                    <button name="action_open_dispose_wizard" type="object" string="Dispose"
                            invisible="state not in ('running', 'close')" groups="account.group_account_manager"/>
                    <button name="action_set_to_draft" type="object" string="Reset to Draft"
                            invisible="state != 'running' or posted_line_count &gt; 0"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,close"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_moves" type="object" class="oe_stat_button" icon="fa-book"
                                invisible="move_count == 0">
                            <field name="move_count" widget="statinfo" string="Entries"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Dell Latitude Laptop" readonly="state != 'draft'"/></h1>
                    </div>
                    <group>
                        <group string="Asset">
                            <field name="category_id" readonly="state != 'draft'"/>
                            <field name="reference"/>
                            <field name="partner_id"/>
                            <field name="source_move_id" invisible="not source_move_id"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="posted_line_count" invisible="1"/>
                        </group>
                        <group string="Values">
                            <field name="acquisition_date" readonly="state != 'draft'"/>
                            <field name="first_depreciation_date" readonly="state != 'draft'"/>
                            <field name="original_value" readonly="state != 'draft'"/>
                            <field name="salvage_value" readonly="state != 'draft'"/>
                            <field name="depreciated_value"/>
                            <field name="book_value"/>
                            <field name="next_depreciation_date" invisible="state != 'running'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Depreciation Board" name="board">
                            <field name="line_ids" readonly="1">
                                <list decoration-success="move_posted" decoration-muted="not move_posted">
                                    <field name="sequence"/>
                                    <field name="date"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="depreciated_value"/>
                                    <field name="remaining_value"/>
                                    <field name="move_id"/>
                                    <field name="move_posted"/>
                                </list>
                            </field>
                        </page>
                        <page string="Depreciation Method" name="method">
                            <group>
                                <group>
                                    <field name="method" readonly="state != 'draft'"/>
                                    <field name="degressive_factor" invisible="method != 'degressive'"
                                           readonly="state != 'draft'"/>
                                    <field name="method_number" readonly="state != 'draft'"/>
                                    <field name="method_period" readonly="state != 'draft'"/>
                                    <field name="prorata" readonly="state != 'draft'"/>
                                </group>
                                <group string="Disposal" invisible="state != 'disposed'">
                                    <field name="disposal_date"/>
                                    <field name="disposal_move_id"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_fixed_asset_search" model="ir.ui.view">
        <field name="name">fixed.asset.search</field>
        <field name="model">fixed.asset</field>
        <field name="arch" type="xml">
            <search string="Search Assets">
                <field name="name"/>
                <field name="reference"/>
                <field name="category_id"/>
                <field name="partner_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="running" string="Running" domain="[('state', '=', 'running')]"/>
                <filter name="close" string="Fully Depreciated" domain="[('state', '=', 'close')]"/>
                <filter name="disposed" string="Disposed" domain="[('state', '=', 'disposed')]"/>
                <group>
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_acquisition" string="Acquisition Date" context="{'group_by': 'acquisition_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fixed_asset" model="ir.actions.act_window">
        <field name="name">Fixed Assets</field>
        <field name="res_model">fixed.asset</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_running': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your first fixed asset</p>
            <p>Create assets manually or set an Asset Category on vendor bill lines to capture them automatically.</p>
        </field>
    </record>
</odoo>
