<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fixed_asset_category_list" model="ir.ui.view">
        <field name="name">fixed.asset.category.list</field>
        <field name="model">fixed.asset.category</field>
        <field name="arch" type="xml">
            <list string="Asset Categories">
                <field name="name"/>
                <field name="method"/>
                <field name="method_number"/>
                <field name="method_period"/>
                <field name="journal_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_fixed_asset_category_form" model="ir.ui.view">
        <field name="name">fixed.asset.category.form</field>
        <field name="model">fixed.asset.category</field>
        <field name="arch" type="xml">
            <form string="Asset Category">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_assets" type="object" class="oe_stat_button" icon="fa-building">
                            <field name="asset_count" widget="statinfo" string="Assets"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Computer Equipment"/></h1>
                    </div>
                    <group>
                        <group string="Depreciation Method">
                            <field name="method"/>
                            <field name="degressive_factor" invisible="method != 'degressive'"/>
                            <field name="method_number"/>
                            <field name="method_period"/>
                            <field name="prorata"/>
                            <field name="auto_confirm"/>
                        </group>
                        <group string="Accounting">
                            <field name="journal_id"/>
                            <field name="account_asset_id"/>
                            <field name="account_depreciation_id"/>
                            <field name="account_expense_id"/>
                            <field name="account_loss_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fixed_asset_category" model="ir.actions.act_window">
        <field name="name">Asset Categories</field>
        <field name="res_model">fixed.asset.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first asset category</p>
            <p>Categories define the accounts, journal and depreciation method applied to assets.</p>
        </field>
    </record>
</odoo>
