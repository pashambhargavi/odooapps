<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fixed_asset_line_list" model="ir.ui.view">
        <field name="name">fixed.asset.line.list</field>
        <field name="model">fixed.asset.line</field>
        <field name="arch" type="xml">
            <tree string="Depreciation Lines" create="0" decoration-success="move_posted">
                <field name="asset_id"/>
                <field name="category_id"/>
                <field name="sequence"/>
                <field name="date"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount" sum="Total"/>
                <field name="depreciated_value"/>
                <field name="remaining_value"/>
                <field name="move_id"/>
                <field name="move_posted"/>
                <button name="action_post" type="object" string="Post" icon="fa-check"
                        invisible="move_id or asset_state != 'running'"/>
                <field name="asset_state" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_fixed_asset_line_pivot" model="ir.ui.view">
        <field name="name">fixed.asset.line.pivot</field>
        <field name="model">fixed.asset.line</field>
        <field name="arch" type="xml">
            <pivot string="Depreciation Analysis" sample="1">
                <field name="category_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_fixed_asset_line_graph" model="ir.ui.view">
        <field name="name">fixed.asset.line.graph</field>
        <field name="model">fixed.asset.line</field>
        <field name="arch" type="xml">
            <graph string="Depreciation Forecast" type="bar" sample="1">
                <field name="date" interval="month"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_fixed_asset_line_search" model="ir.ui.view">
        <field name="name">fixed.asset.line.search</field>
        <field name="model">fixed.asset.line</field>
        <field name="arch" type="xml">
            <search string="Depreciation Lines">
                <field name="asset_id"/>
                <field name="category_id"/>
                <filter name="posted" string="Posted" domain="[('move_posted', '=', True)]"/>
                <filter name="to_post" string="To Post" domain="[('move_id', '=', False)]"/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="group_asset" string="Asset" context="{'group_by': 'asset_id'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fixed_asset_line" model="ir.actions.act_window">
        <field name="name">Depreciation Analysis</field>
        <field name="res_model">fixed.asset.line</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('asset_id.state', '!=', 'draft')]</field>
    </record>
</odoo>
