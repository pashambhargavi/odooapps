              name="WhatsApp"
              web_icon="whatsapp_omnichannel_messaging_hub,static/description/icon.png"
              sequence="40"/>

    <!-- Submenus -->
    <menuitem id="menu_whatsapp_logs"
              name="Message Logs"
              parent="menu_whatsapp_root"
