<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_whatsapp" model="ir.ui.view">
        <field name="name">stock.picking.form.whatsapp</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_whatsapp" string="WhatsApp" type="object" class="btn-success" icon="fa-whatsapp" invisible="state == 'cancel'"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_whatsapp_logs" type="object" class="oe_stat_button" icon="fa-whatsapp">
                    <field name="whatsapp_log_count" widget="statinfo" string="WhatsApp"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
