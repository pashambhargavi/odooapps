<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_whatsapp" model="ir.ui.view">
        <field name="name">account.move.form.whatsapp</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_whatsapp" string="WhatsApp" type="object" class="btn-success" icon="fa-whatsapp" invisible="state == 'cancel'"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_whatsapp_logs" type="object" class="oe_stat_button" icon="fa-whatsapp">
                    <field name="whatsapp_log_count" widget="statinfo" string="WhatsApp"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
