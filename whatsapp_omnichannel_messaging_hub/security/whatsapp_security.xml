<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_whatsapp" model="ir.module.category">
        <field name="name">WhatsApp Omnichannel</field>
        <field name="description">1-Click WhatsApp customer messaging, dynamic templates, and audit logs.</field>
        <field name="sequence">26</field>
    </record>

    <record id="group_whatsapp_user" model="res.groups">
        <field name="name">User: Send WhatsApp Messages</field>
        <field name="category_id" ref="module_category_whatsapp"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_whatsapp_manager" model="res.groups">
        <field name="name">Administrator: Manage Templates &amp; Audit Logs</field>
        <field name="category_id" ref="module_category_whatsapp"/>
        <field name="implied_ids" eval="[(4, ref('group_whatsapp_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('whatsapp_omnichannel_messaging_hub.group_whatsapp_user'))]"/>
    </record>

    <data noupdate="1">
        <record id="rule_whatsapp_template_company" model="ir.rule">
            <field name="name">WhatsApp Template: Multi-Company</field>
            <field name="model_id" ref="model_whatsapp_template"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="rule_whatsapp_log_company" model="ir.rule">
            <field name="name">WhatsApp Log: Multi-Company</field>
            <field name="model_id" ref="model_whatsapp_message_log"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
    </data>
</odoo>
