<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_hr_training" model="ir.module.category">
        <field name="name">Training &amp; Certification</field>
        <field name="description">Manage corporate training courses, sessions, employee certifications, and compliance matrices.</field>
        <field name="sequence">35</field>
    </record>

    <record id="privilege_hr_training" model="res.groups.privilege">
        <field name="name">Training &amp; Certification Access</field>
        <field name="category_id" ref="module_category_hr_training"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_training_user" model="res.groups">
        <field name="name">Training Attendee / Employee</field>
        <field name="privilege_id" ref="privilege_hr_training"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_training_manager" model="res.groups">
        <field name="name">Training Officer / Compliance Manager</field>
        <field name="privilege_id" ref="privilege_hr_training"/>
        <field name="implied_ids" eval="[(4, ref('group_training_user')), (4, ref('hr.group_hr_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('hr_training_certification_management.group_training_user'))]"/>
    </record>

    <data noupdate="1">
        <!-- Multi-Company Rules -->
        <record id="rule_training_course_company" model="ir.rule">
            <field name="name">Training Course: Multi-Company</field>
            <field name="model_id" ref="model_training_course"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_training_session_company" model="ir.rule">
            <field name="name">Training Session: Multi-Company</field>
            <field name="model_id" ref="model_training_session"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_training_participation_company" model="ir.rule">
            <field name="name">Training Record: Multi-Company</field>
            <field name="model_id" ref="model_training_participation"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_training_compliance_matrix_company" model="ir.rule">
            <field name="name">Compliance Matrix: Multi-Company</field>
            <field name="model_id" ref="model_training_compliance_matrix"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Employee Personal Record Rule -->
        <record id="rule_training_participation_employee" model="ir.rule">
            <field name="name">Training Record: Employee Own</field>
            <field name="model_id" ref="model_training_participation"/>
            <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('employee_id.user_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('group_training_user'))]"/>
        </record>

        <record id="rule_training_participation_manager" model="ir.rule">
            <field name="name">Training Record: Manager All</field>
            <field name="model_id" ref="model_training_participation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_training_manager'))]"/>
        </record>
    </data>
</odoo>
