<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_approval_reject_wizard_form" model="ir.ui.view">
        <field name="name">approval.reject.wizard.form</field>
        <field name="model">approval.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Approval">
                <group>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                    <field name="reason" nolabel="1" placeholder="Provide a clear reason for refusing/rejecting this request..."/>
                </group>
                <footer>
                    <button name="action_confirm_reject" string="Confirm Rejection" type="object" class="btn-danger" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
