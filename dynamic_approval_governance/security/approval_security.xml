<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_approval_governance" model="ir.module.category">
        <field name="name">Approval Matrix Governance</field>
        <field name="parent_id" ref="base.module_category_productivity"/>
        <field name="sequence">15</field>
    </record>

    <record id="group_approval_user" model="res.groups">
        <field name="name">User: Own &amp; Assigned Approvals</field>
        <field name="comment">Can submit approval requests and approve assigned tiers.</field>
        <field name="category_id" ref="module_category_approval_governance"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_approval_manager" model="res.groups">
        <field name="name">Administrator: Manage Categories &amp; Matrix Rules</field>
        <field name="comment">Full access to approval requests, categories, and multi-level matrix rules.</field>
        <field name="category_id" ref="module_category_approval_governance"/>
        <field name="implied_ids" eval="[(4, ref('dynamic_approval_governance.group_approval_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">
        <!-- Multi-company Record Rules -->
        <record id="approval_category_comp_rule" model="ir.rule">
            <field name="name">Approval Category: multi-company</field>
            <field name="model_id" ref="model_approval_category"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="approval_request_comp_rule" model="ir.rule">
            <field name="name">Approval Request: multi-company</field>
            <field name="model_id" ref="model_approval_request"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="approval_matrix_rule_comp_rule" model="ir.rule">
            <field name="name">Approval Matrix Rule: multi-company</field>
            <field name="model_id" ref="model_approval_matrix_rule"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
    </data>
</odoo>
