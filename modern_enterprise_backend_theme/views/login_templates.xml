<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="modern_enterprise_login_layout" inherit_id="web.login_layout" name="Modern Enterprise Login Layout">
        <xpath expr="//div[hasclass('container')]" position="replace">
            <div class="container-fluid p-0 o_theme_login_container" style="min-height: 100vh; display: flex; align-items: stretch; background-color: #0F172A; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
                <div class="row g-0 w-100 m-0">
                    <!-- Left Brand Hero Column -->
                    <div class="col-12 col-lg-7 d-none d-lg-flex flex-column justify-content-between p-5 text-white" style="background-color: #0F172A; border-right: 1px solid #1E293B;">
                        <div>
                            <div class="d-flex align-items-center mb-4">
                                <span style="display: inline-block; background-color: #2563EB; color: #FFFFFF; font-weight: 800; font-size: 13px; padding: 4px 14px; border-radius: 20px; letter-spacing: 1px; text-transform: uppercase;">
                                    ENTERPRISE WORKSPACE
                                </span>
                            </div>
                            <h1 style="font-size: 38px; font-weight: 800; line-height: 1.2; margin-bottom: 20px; color: #FFFFFF;">
                                Unified Business Intelligence &amp; Cloud Operations
                            </h1>
                            <p style="font-size: 16px; color: #94A3B8; max-width: 560px; line-height: 1.6;">
                                Access your corporate enterprise suite: CRM, Global Accounting, Inventory &amp; Supply Chain, Manufacturing QMS, and HR Governance.
                            </p>
                        </div>

                        <!-- Feature Badges -->
                        <div class="row g-3 my-4">
                            <div class="col-6">
                                <div style="background-color: #1E293B; border: 1px solid #334155; border-radius: 8px; padding: 16px;">
                                    <div style="color: #38BDF8; font-weight: 700; font-size: 14px; margin-bottom: 4px;">⚡ Real-Time ERP Speed</div>
                                    <div style="color: #94A3B8; font-size: 12px;">High-performance transactions with instant multi-ledger sync.</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div style="background-color: #1E293B; border: 1px solid #334155; border-radius: 8px; padding: 16px;">
                                    <div style="color: #34D399; font-weight: 700; font-size: 14px; margin-bottom: 4px;">🔒 Bank-Grade Security</div>
                                    <div style="color: #94A3B8; font-size: 12px;">Role-based governance, 2FA authorization &amp; audit trails.</div>
                                </div>
                            </div>
                        </div>

                        <!-- Copyright / Tech Info -->
                        <div style="color: #64748B; font-size: 13px;">
                            Powered by NextGen Enterprise Backend Theme &#8226; Compatible with Community &amp; Enterprise
                        </div>
                    </div>

                    <!-- Right Login Form Column -->
                    <div class="col-12 col-lg-5 d-flex flex-column justify-content-center align-items-center p-4 p-md-5" style="background-color: #1E293B;">
                        <div style="width: 100%; max-width: 420px; background-color: #0F172A; border: 1px solid #334155; border-radius: 12px; padding: 36px 30px; box-shadow: 0 10px 25px rgba(0,0,0,0.3);">
                            <div class="text-center mb-4">
                                <h3 style="color: #FFFFFF; font-size: 22px; font-weight: 800; margin: 0 0 6px 0;">Sign In</h3>
                                <p style="color: #94A3B8; font-size: 13px; margin: 0;">Enter your credentials to access your session</p>
                            </div>
                            <t t-out="0"/>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>

