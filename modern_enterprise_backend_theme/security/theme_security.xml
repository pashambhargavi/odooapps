<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_theme_customizer" model="ir.module.category">
        <field name="name">Enterprise Theme &amp; UI Customizer</field>
        <field name="description">Manage enterprise theme layouts, color presets, dark mode, and corporate branding.</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_theme_user" model="res.groups">
        <field name="name">Theme User (Personal Dark Mode &amp; Density)</field>
        <field name="category_id" ref="module_category_theme_customizer"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_theme_manager" model="res.groups">
        <field name="name">Theme Administrator (Brand &amp; Layout Manager)</field>
        <field name="category_id" ref="module_category_theme_customizer"/>
        <field name="implied_ids" eval="[(4, ref('group_theme_user')), (4, ref('base.group_system'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('modern_enterprise_backend_theme.group_theme_user'))]"/>
    </record>

    <data noupdate="1">
        <!-- Multi-Company Rule -->
        <record id="rule_theme_config_company" model="ir.rule">
            <field name="name">Theme Configuration: Multi-Company</field>
            <field name="model_id" ref="model_theme_config"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
